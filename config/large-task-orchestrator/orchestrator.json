{
  "version": 1,
  "routing": {
    "worker": {
      "default": [
        { "agent": "codex", "model_preference": "gpt-5.6-sol" },
        {
          "agent": "cursor",
          "max_difficulty": "standard",
          "reason": "cursor-agent keeps the user-selected default model, so no model_preference is set; the standard ceiling leaves complex and critical Stories to the deeper agents."
        },
        { "agent": "codexl", "model_preference": "gpt-5.6-sol" },
        { "agent": "kiro", "model_preference": "gpt-5.6-sol" }
      ],
      "frontend": [
        { "agent": "kimi" },
        { "agent": "codexl", "model_preference": "gpt-5.6-sol" },
        { "agent": "codex", "model_preference": "gpt-5.6-sol" },
        { "agent": "kiro", "model_preference": "gpt-5.6-sol" }
      ]
    },
    "validator": {
      "default": [
        {
          "agent": "pi",
          "model_preference": "zai/glm-5.3-flash"
        },
        {
          "agent": "kiro",
          "acpx_command": "kiro-cli-chat acp --effort xhigh",
          "native_args": [
            "--effort",
            "xhigh"
          ],
          "model_preference": "gpt-5.6-luna",
          "reason": "Luna keeps lightweight validation focused; the default Sol tends to broaden review scope."
        }
      ]
    }
  },
  "profiles": [
    {
      "name": "codex-worker",
      "match": {
        "role": "worker",
        "agent": "codex"
      },
      "effort_by_difficulty": {
        "routine": "low",
        "standard": "medium",
        "complex": "high",
        "critical": "max"
      }
    },
    {
      "name": "codexl-worker",
      "match": {
        "role": "worker",
        "agent": "codexl"
      },
      "effort_by_difficulty": {
        "routine": "low",
        "standard": "medium",
        "complex": "high",
        "critical": "max"
      }
    },
    {
      "name": "kimi-worker",
      "match": {
        "role": "worker",
        "agent": "kimi"
      },
      "effort_by_difficulty": {
        "routine": "max",
        "standard": "max",
        "complex": "max",
        "critical": "max"
      }
    },
    {
      "name": "pi-validator",
      "match": {
        "role": "validator",
        "agent": "pi"
      },
      "effort_by_difficulty": {
        "routine": "high",
        "standard": "high",
        "complex": "xhigh",
        "critical": "xhigh"
      }
    },
    {
      "name": "kiro-worker",
      "match": {
        "role": "worker",
        "agent": "kiro"
      },
      "effort_by_difficulty": {
        "routine": "medium",
        "standard": "medium",
        "complex": "high",
        "critical": "high"
      }
    },
    {
      "name": "kiro-luna-validator",
      "match": {
        "role": "validator",
        "agent": "kiro"
      },
      "effort_by_difficulty": {
        "routine": "xhigh",
        "standard": "xhigh",
        "complex": "xhigh",
        "critical": "xhigh"
      }
    }
  ]
}
