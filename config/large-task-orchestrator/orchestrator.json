{
  "version": 1,
  "routing": {
    "worker": {
      "default": [
        { "agent": "codexp" },
        { "agent": "codex" },
        { "agent": "codexl" },
        { "agent": "kiro" }
      ],
      "frontend": [
        { "agent": "kimi" },
        { "agent": "codexl" },
        { "agent": "codex" },
        { "agent": "codexp" },
        { "agent": "kiro" }
      ]
    },
    "validator": {
      "default": [
        {
          "agent": "pi",
          "model_contains": "deepseek-v4-flash"
        },
        {
          "agent": "kiro",
          "acpx_command": "kiro-cli-chat acp --model gpt-5.6-luna --effort xhigh",
          "native_args": [
            "--model",
            "gpt-5.6-luna",
            "--effort",
            "xhigh"
          ],
          "model_contains": "luna",
          "reason": "Luna keeps lightweight validation focused; the default Sol tends to broaden review scope."
        }
      ]
    }
  },
  "profiles": [
    {
      "name": "codexp-worker",
      "match": {
        "role": "worker",
        "agent": "codexp"
      },
      "effort_by_difficulty": {
        "routine": "low",
        "standard": "medium",
        "complex": "high",
        "critical": "max"
      }
    },
    {
      "name": "codex-worker",
      "match": {
        "role": "worker",
        "agent": "codex"
      },
      "effort_by_difficulty": {
        "routine": "low",
        "standard": "medium",
        "complex": "high",
        "critical": "max"
      }
    },
    {
      "name": "codexl-worker",
      "match": {
        "role": "worker",
        "agent": "codexl"
      },
      "effort_by_difficulty": {
        "routine": "low",
        "standard": "medium",
        "complex": "high",
        "critical": "max"
      }
    },
    {
      "name": "kimi-worker",
      "match": {
        "agent": "kimi"
      },
      "effort_by_difficulty": {
        "routine": "max",
        "standard": "max",
        "complex": "max",
        "critical": "max"
      }
    },
    {
      "name": "pi-deepseek-v4-flash",
      "match": {
        "agent": "pi",
        "model_contains": "deepseek-v4-flash"
      },
      "effort_by_difficulty": {
        "routine": "high",
        "standard": "high",
        "complex": "xhigh",
        "critical": "xhigh"
      }
    },
    {
      "name": "kiro-worker",
      "match": {
        "agent": "kiro"
      },
      "effort_by_difficulty": {
        "routine": "medium",
        "standard": "medium",
        "complex": "high",
        "critical": "high"
      }
    },
    {
      "name": "kiro-luna-validator",
      "match": {
        "role": "validator",
        "agent": "kiro",
        "model_contains": "luna"
      },
      "effort_by_difficulty": {
        "routine": "xhigh",
        "standard": "xhigh",
        "complex": "xhigh",
        "critical": "xhigh"
      }
    }
  ]
}
