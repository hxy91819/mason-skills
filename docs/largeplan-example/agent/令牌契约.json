{
  "kind": "agent-reference",
  "schema_version": 1,
  "id": "token-contract",
  "title": "一次性令牌契约",
  "updated": "2026-08-18",
  "body": {
    "token": {
      "format": "32 字节随机数，base64url 编码；服务端只存 SHA-256 摘要",
      "ttl_minutes": 15,
      "single_use": true,
      "allowed_email_domains": [
        "企业域名白名单，实施时从运维配置读取"
      ]
    },
    "delivery": {
      "channel": "企业邮箱",
      "contents": "登录链接与 6 位数字验证码",
      "login_path": "/login/token",
      "send_timeout_seconds": 10,
      "retry": "失败后退避重试 2 次"
    },
    "rate_limit": {
      "per_email_per_minute": 1,
      "per_email_hourly": 5,
      "per_source_ip_hourly": 20,
      "lockout_minutes_after_failures": 15,
      "failures_before_lockout": 10
    },
    "session": {
      "mechanism": "文档站现有会话 cookie",
      "ttl_hours": 12,
      "identity": "员工企业邮箱"
    },
    "audit": {
      "events": [
        "issue",
        "verify_ok",
        "verify_fail",
        "lockout"
      ],
      "fields": [
        "时间",
        "邮箱",
        "来源地址",
        "结果"
      ],
      "retention_days": 180
    },
    "rollout": {
      "delivery_success_rate": 0.995,
      "login_success_rate": 0.99,
      "gray_first_day_team": "行政团队"
    }
  }
}
