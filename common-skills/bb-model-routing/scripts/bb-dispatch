#!/usr/bin/env python3
"""Validate BB routes against the user configuration and create one thread.

Does not split tasks, retry creation, or modify environments beforehand.

defaults.<route> is an ordered fallback chain or a load-balance candidate set. Candidates are validated
only before spawn (provider availability, permissions, model catalog and circuit-breaker cooldown) and
the first one that passes is dispatched; any failure after spawn is issued aborts and cools that
candidate, and the caller reruns after confirming no thread was created.
Cooldowns never read error text. When a child thread errors, --on-failure retries it in the original
session with backoff, so transient errors are absorbed there; only exhausted retries count as failures.
Structured quota signals skip the original-session retries and go straight to a longer quota cooldown
for that provider and model.
Every dispatch first marks ledger threads that BB reports as finished as completed; one success resets
the cooldown. When a parent thread is linked, a fixed reporting section is appended to the task so the
child holds its reports until the turn ends.

See --help for options. stdout is JSON; stderr carries errors and review reminders; exit code 0 on
success, 2 on failure. Requires Python 3.10+, PyYAML and bb on PATH.
"""
import argparse
import contextlib
import datetime
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time
import uuid

import yaml

try:
    import fcntl
except ImportError:  # Windows has no fcntl; the ledger falls back to unlocked writes.
    fcntl = None


class DispatchError(Exception):
    def __init__(self, message, code=None):
        super().__init__(message)
        # error.code from the stdout error envelope of a failed BB --json call (e.g. retry_already_queued); None otherwise.
        self.code = code


DIFFICULTIES = ("simple", "medium", "complex")
# Advisors answer questions and propose plans rather than do Worker tasks; they have their own route, chosen
# by --purpose advise instead of a difficulty.
ADVISOR_ROUTE = "advisor"
PURPOSES = ("work", "review", "advise")
ROUTES = (*DIFFICULTIES, ADVISOR_ROUTE)
ROUTE_KEYS = frozenset((*ROUTES, "default"))
TITLE_PREFIXES = {"simple": "🟢", "medium": "🟡", "complex": "🔴", "advisor": "🟣"}
SHAPED_TITLE_PREFIXES = {
    "circle": {"simple": "🟢", "medium": "🟡", "complex": "🔴", "advisor": "🟣"},
    "square": {"simple": "🟩", "medium": "🟨", "complex": "🟥", "advisor": "🟪"},
    "heart": {"simple": "💚", "medium": "💛", "complex": "❤️", "advisor": "💜"},
    "book": {"simple": "📗", "medium": "📒", "complex": "📕", "advisor": "📔"},
}
AGENT_SHAPES = {
    "codex": "circle",
    "codexl": "square",
    "codex-l": "square",
    "codexb": "heart",
    "codex-b": "heart",
    "codexm": "book",
    "codex-m": "book",
}
ALL_TITLE_PREFIXES = tuple(
    dict.fromkeys(
        ["[Agent]"]
        + list(TITLE_PREFIXES.values())
        + [char for s in SHAPED_TITLE_PREFIXES.values() for char in s.values()]
    )
)
OUTCOME_KEYS = ("spawned", "completed", "failed", "failed_quota", "failed_transient", "failed_other")
# failed is recorded automatically; the other failed_* values come from legacy manual write-backs and cool the same way.
FAILED_OUTCOMES = ("failed", "failed_quota", "failed_transient", "failed_other")
# In post-delivery messages these prefixes mark tool or system notices, not follow-ups from the parent or the user.
NOTICE_PREFIXES = ("[bb_long_task]", "[bb system]")
FOLLOWUP_TEXT_MAX_CHARS = 600
BACKOFF_BASE_SECONDS = 15 * 60
# Without a reset window, quota cooldowns start at 1 hour and double; a later known subscription reset extends them to that moment.
QUOTA_BACKOFF_BASE_SECONDS = 60 * 60
BACKOFF_MAX_SECONDS = 6 * 3600
SPAWN_COOLDOWN_SECONDS = 15 * 60
# Original-session retries: once each after 1, 2 and 4 minutes; only exhausted retries count toward cooldown. Quota failures skip them.
SESSION_RETRY_LIMIT = 3
SESSION_RETRY_BASE_SECONDS = 60
# When BB has already retried to its limit in the original session, more retries are pointless. Quota declines: QUOTA_DECLINE_REASONS.
BB_RETRY_GAVE_UP = ("attempts-exhausted",)
# provider-retry classifies these declines as quota and will not wait for recovery in the original session.
QUOTA_DECLINE_REASONS = ("no-rate-limit-state", "not-resettable", "beyond-maximum-wait")
# Only these JSON field values count; error sentences are never scanned for the same words.
QUOTA_CODE_FIELDS = ("code", "status", "type")
QUOTA_CODES = frozenset({"resource_exhausted", "model_cooldown", "insufficient_quota", "quota_exceeded", "quota"})
# Recent window shared by outcome detection, cooldown computation and ledger entry retention.
RECENT_WINDOW_SECONDS = 48 * 3600
LEDGER_LOCK_WAIT_SECONDS = 5
# Persisted as ledger cooldown reasons; earlier versions wrote Chinese text, mapped to English when read.
QUOTA_WINDOW_REASON = "quota window"
LEGACY_COOLDOWN_REASONS = {"额度窗口": QUOTA_WINDOW_REASON}
MAX_LIVE_ENTRIES = 200
# When the review log exceeds the cap, the older half is dropped; summaries read only 7 days, and normal use keeps weeks.
EVENTS_MAX_BYTES = 4 * 1024 * 1024
UNKNOWN_MAX_CHARS = 120
# Markers emitted verbatim by other skills (autoreview's review prompt, large-task-orchestrator's driver);
# they must match those skills' text, so they stay as-is.
REVIEW_PROMPT_ANCHOR = "# Review agent 提示词"
DRIVER_PAYLOAD_ANCHORS = (
    "\n执行包：\n",
    "\n完成工作后必须提交结构化报告。",
    "\n完成裁决后必须提交结构化报告。",
)
# Appended when a parent thread is linked: every intermediate child message wakes or interrupts the parent,
# so reports are held until the turn ends.
REPORT_PROTOCOL_ANCHOR = "\n\n## How to report (appended by bb-dispatch)\n"
# Threads spawned by earlier versions carry the Chinese anchor; copied tasks must still strip it.
LEGACY_REPORT_PROTOCOL_ANCHORS = ("\n\n## 回报方式（bb-dispatch 附加）\n",)
REPORT_PROTOCOL = (
    "When your turn ends, BB automatically delivers your final reply to the parent thread; every message you send it "
    "mid-turn with `bb thread tell` wakes or interrupts it. "
    "Hold progress, interim findings, newly created resources and replies to the parent's follow-up messages until "
    "the turn ends and report them once as the task requires; "
    "write facts that need an immediate record (such as resource IDs) to a workspace file first. "
    "If the task body says otherwise, the task body wins."
)
# Long tasks wake the parent at every turn end (waiting for CI, waiting for review); stuck/off only wake it
# automatically on failure, when stuck, or when awaiting approval, and the child tells it everything else explicitly.
PARENT_NOTIFICATION_MODES = ("auto", "stuck", "off")
QUIET_REPORT_PROTOCOL = (
    "The parent thread is not notified automatically when your turn ends. Send it one message with "
    "`bb thread tell <parent-thread-ID>` only when: the parent must approve something; it must decide or you are stuck; "
    "a phase is complete (include a delivery summary); you find a problem outside your scope. Do not report progress. "
    "Write facts that need an immediate record (such as resource IDs) to a workspace file first. "
    "If the task body says otherwise, the task body wins."
)


def strip_report_protocol(task):
    """Remove an appended report protocol (current or legacy anchor) from a task copied from a child's first message."""
    for anchor in (REPORT_PROTOCOL_ANCHOR, *LEGACY_REPORT_PROTOCOL_ANCHORS):
        task = task.split(anchor, 1)[0]
    return task


def bb(*args):
    creating = args[:2] == ("thread", "spawn")
    try:
        result = subprocess.run(["bb", *args, "--json"], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as exc:
        suffix = " Creation result unknown; query threads first, do not retry directly." if creating else ""
        raise DispatchError(f"BB call failed: {exc}.{suffix}") from exc
    if result.returncode:
        suffix = " Query threads first to confirm whether one was created; do not retry directly." if creating else ""
        try:
            error = json.loads(result.stdout).get("error")
        except (ValueError, AttributeError):
            error = None
        error = error if isinstance(error, dict) else {}
        code = error.get("code")
        detail = ": ".join(str(part) for part in (code, error.get("message")) if part) or result.stderr.strip()
        raise DispatchError(f"bb {' '.join(args[:2])} failed: {detail[:1000]}{suffix}", code=code)
    try:
        return json.loads(result.stdout)
    except ValueError as exc:
        raise DispatchError("BB returned non-JSON output." + (" Creation result unknown; do not retry directly." if creating else "")) from exc


def mapping(value, where):
    if not isinstance(value, dict):
        raise DispatchError(f"{where} must be a mapping.")
    return value


def string(value, where):
    if not isinstance(value, str) or not value.strip():
        raise DispatchError(f"{where} must be a non-empty string.")
    return value


def unique(items, key, value, label):
    if not isinstance(items, list):
        raise DispatchError(f"{label} catalog has an unknown format.")
    matches = [item for item in items if isinstance(item, dict) and item.get(key) == value]
    if len(matches) != 1:
        raise DispatchError(f"{label} {value!r} is missing or not unique; check the user configuration.")
    return matches[0]


def configured_bool(override, config, key, default, where):
    if key in override:
        source, label = override, f"environment {where}"
    elif key in config:
        source, label = config, where
    else:
        return default
    value = source[key]
    if not isinstance(value, bool):
        raise DispatchError(f"{label} must be true or false.")
    return value


def tier_ids(entries):
    if not isinstance(entries, list):
        return None
    return [item.get("id") for item in entries if isinstance(item, dict) and item.get("id")]


def supports_service_tier(provider, model, tier):
    provider_ids = tier_ids(provider.get("serviceTiers"))
    if provider_ids is None or tier not in provider_ids:
        return False
    if tier == "default":
        return True
    model_ids = tier_ids(model.get("supportedServiceTiers"))
    return True if model_ids is None else tier in model_ids


def thread_title(title, task, difficulty, shape="circle"):
    text = " ".join((title or "").split()) or " ".join(task.split())
    while True:
        prefix = next((p for p in ALL_TITLE_PREFIXES if text == p or text.startswith(p + " ")), None)
        if prefix is None:
            break
        text = text[len(prefix):].strip()
    text = text or "Task"
    if len(text) > 80:
        text = text[:79] + "…"
    prefix_map = SHAPED_TITLE_PREFIXES.get(shape, TITLE_PREFIXES)
    prefix_char = prefix_map.get(difficulty, "⚪")
    return prefix_char + " " + text


def effective_task_chars(task):
    body = task.split(REVIEW_PROMPT_ANCHOR, 1)[0] if REVIEW_PROMPT_ANCHOR in task else task
    for anchor in DRIVER_PAYLOAD_ANCHORS:
        if anchor in body:
            body = body.split(anchor, 1)[0]
    # Worker report block embedded by large-task-orchestrator's judge prompt.
    if "\nWorker 报告：" in body and "\n需要证据时读取对应 BB 线程" in body:
        before, rest = body.split("\nWorker 报告：", 1)
        _, after = rest.split("\n需要证据时读取对应 BB 线程", 1)
        body = before + "\n需要证据时读取对应 BB 线程" + after
    if "# Verified context" in body and "# Question for the oracle" in body:
        before, rest = body.split("# Verified context", 1)
        if "# Question for the oracle" in rest:
            _, after = rest.split("# Question for the oracle", 1)
            body = before + "# Question for the oracle" + after
    return len(body.strip())


def ledger_path_from(args):
    raw = getattr(args, "ledger", None) or os.environ.get(
        "BB_DISPATCH_LEDGER_PATH", str(Path.home() / ".cache/bb-dispatch/ledger.json")
    )
    return Path(raw).expanduser()


def empty_ledger():
    return {"version": 1, "entries": [], "rollups": {}, "cooldowns": {}}


def load_ledger(path, strict=False):
    if not path.exists():
        return empty_ledger()
    try:
        data = json.loads(path.read_text())
        if not isinstance(data, dict) or data.get("version") != 1:
            raise ValueError("invalid ledger version or format")
        if not isinstance(data.get("entries"), list) or not isinstance(data.get("rollups"), dict) or not isinstance(data.get("cooldowns"), dict):
            raise ValueError("ledger fields missing or of the wrong type")
        return data
    except Exception as exc:
        if strict:
            raise DispatchError(f"cannot read run ledger {path}: {exc}") from exc
        print(f"warning: ledger read failed (ignored, continuing): {exc}", file=sys.stderr)
        return empty_ledger()


def save_ledger(path, data, strict=False):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2))
        tmp.replace(path)
    except Exception as exc:
        if strict:
            raise DispatchError(f"cannot write run ledger {path}: {exc}") from exc
        print(f"warning: ledger write failed (ignored, continuing): {exc}", file=sys.stderr)


@contextlib.contextmanager
def ledger_lock(path):
    """Serialize ledger read-modify-write across processes; failing to get the lock only warns and never blocks dispatch."""
    handle = None
    if fcntl is not None:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            handle = open(path.with_name(path.name + ".lock"), "a")
            deadline = time.monotonic() + LEDGER_LOCK_WAIT_SECONDS
            while True:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise TimeoutError(f"waited more than {LEDGER_LOCK_WAIT_SECONDS}s")
                    time.sleep(0.05)
        except Exception as exc:
            print(f"warning: ledger lock failed (continuing without it): {exc}", file=sys.stderr)
            if handle is not None:
                handle.close()
                handle = None
    try:
        yield
    finally:
        if handle is not None:
            handle.close()


def events_path(ledger_path):
    """Append-only review log next to the ledger: ledger.json pairs with ledger.events.jsonl."""
    return ledger_path.with_name(ledger_path.stem + ".events.jsonl")


def append_events(ledger_path, events):
    """One JSON event per line; the caller holds the ledger lock. Write failures only warn and never block dispatch."""
    if not events:
        return
    try:
        target = events_path(ledger_path)
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open("a") as handle:
            handle.writelines(json.dumps(event, ensure_ascii=False) + "\n" for event in events)
        if target.stat().st_size > EVENTS_MAX_BYTES:
            lines = target.read_text().splitlines(keepends=True)
            tmp = target.with_suffix(target.suffix + ".tmp")
            tmp.write_text("".join(lines[len(lines) // 2:]))
            tmp.replace(target)
    except Exception as exc:
        print(f"warning: review log write failed (ignored, continuing): {exc}", file=sys.stderr)


def update_ledger(path, mutate, strict=False):
    """Reread and rewrite the ledger under the lock so concurrent dispatches and write-backs never overwrite each other;
    review events returned by mutate are then appended to the log."""
    with ledger_lock(path):
        ledger = load_ledger(path, strict=strict)
        events = mutate(ledger)
        save_ledger(path, ledger, strict=strict)
        append_events(path, events)
    return ledger


def rollup_entry(rollups, entry):
    key = f"{entry.get('difficulty')}|{entry.get('agent')}|{entry.get('provider')}|{entry.get('model')}"
    bucket = rollups.get(key)
    if not isinstance(bucket, dict):
        bucket = {
            "difficulty": entry.get("difficulty"),
            "agent": entry.get("agent"),
            "provider": entry.get("provider"),
            "model": entry.get("model"),
            "total": 0,
            "outcomes": {k: 0 for k in OUTCOME_KEYS},
        }
        rollups[key] = bucket
    bucket["total"] = int(bucket.get("total", 0)) + 1
    outcome = entry.get("outcome") or "spawned"
    if outcome in OUTCOME_KEYS:
        bucket["outcomes"][outcome] = int(bucket["outcomes"].get(outcome, 0)) + 1


def outcome_time(entry):
    """Time of the entry's outcome; legacy entries without outcome_ts use the dispatch time."""
    return int(entry.get("outcome_ts") or entry.get("ts") or 0)


def append_ledger_entry(ledger, entry, max_live=MAX_LIVE_ENTRIES, now=None):
    entries = ledger.setdefault("entries", [])
    rollups = ledger.setdefault("rollups", {})
    # An existing entry with the same stable ID is overwritten in place to avoid double counting.
    for idx, existing in enumerate(entries):
        if isinstance(existing, dict) and existing.get("id") == entry["id"]:
            entries[idx] = entry
            return
    entries.append(entry)
    excess = len(entries) - max_live
    if excess <= 0:
        return
    # Entries inside the recent window still feed outcome detection and cooldowns, so they stay even over the cap;
    # only older entries are rolled up.
    horizon = int(time.time() if now is None else now) - RECENT_WINDOW_SECONDS
    kept = []
    for item in entries:
        if excess > 0 and (not isinstance(item, dict) or outcome_time(item) < horizon):
            if isinstance(item, dict):
                rollup_entry(rollups, item)
            excess -= 1
        else:
            kept.append(item)
    entries[:] = kept


def health_key(provider, model):
    return f"{provider}|{model}"


def backoff_seconds(level, quota=False):
    base = QUOTA_BACKOFF_BASE_SECONDS if quota else BACKOFF_BASE_SECONDS
    return min(BACKOFF_MAX_SECONDS, base * 2 ** (level - 1))


def set_explicit_cooldown(ledger, provider, model, reason, now):
    """Candidates whose spawn failed or that --fallback-from skipped have no thread status, so they get a fixed cooldown."""
    table = ledger.setdefault("cooldowns", {})
    key = health_key(provider, model)
    current = table.get(key)
    # A concurrent process may already have recorded a longer cooldown; never shorten it.
    if isinstance(current, dict) and int(current.get("until") or 0) >= now + SPAWN_COOLDOWN_SECONDS:
        return
    table[key] = {
        "provider": provider,
        "model": model,
        "reason": reason,
        "since": now,
        "until": now + SPAWN_COOLDOWN_SECONDS,
    }


def set_quota_window(ledger, provider, model, now, until):
    """When the subscription window resets later than the level-based cooldown, extend the cooldown to that moment."""
    table = ledger.setdefault("cooldowns", {})
    key = health_key(provider, model)
    current = table.get(key)
    if isinstance(current, dict) and int(current.get("until") or 0) >= until:
        return
    table[key] = {
        "provider": provider, "model": model, "reason": QUOTA_WINDOW_REASON, "since": now, "until": until, "quota": True,
    }


def latest_success_at(ledger):
    """Latest success time per provider+model in the ledger, not limited to the 48-hour horizon."""
    latest = {}
    for entry in ledger.get("entries") or []:
        if not isinstance(entry, dict) or entry.get("outcome") != "completed":
            continue
        if not entry.get("provider") or not entry.get("model"):
            continue
        key = health_key(entry["provider"], entry["model"])
        latest[key] = max(latest.get(key, 0), outcome_time(entry))
    return latest


def forget_cleared_cooldowns(ledger):
    """One success deletes earlier explicit cooldowns so they do not revive once that success leaves the 48-hour horizon."""
    table = ledger.get("cooldowns")
    if not isinstance(table, dict):
        return
    latest = latest_success_at(ledger)
    for key in [k for k, cd in table.items()
                if isinstance(cd, dict) and latest.get(k, 0) > int(cd.get("since") or 0)]:
        del table[key]


def health_cooldowns(ledger, now):
    """Compute current cooldowns per provider and model from outcomes inside the recent window.

    Ordinary failures double from BACKOFF_BASE_SECONDS, failures marked quota double from
    QUOTA_BACKOFF_BASE_SECONDS; both cap at BACKOFF_MAX_SECONDS and one success resets them. Failures during
    a cooldown only extend it; a failure after it ends raises the level. A manually written failed_quota has
    no quota mark and counts as an ordinary failure.
    """
    horizon = now - RECENT_WINDOW_SECONDS
    events = {}
    for entry in ledger.get("entries") or []:
        if not isinstance(entry, dict) or not entry.get("provider") or not entry.get("model"):
            continue
        outcome = entry.get("outcome")
        if outcome != "completed" and outcome not in FAILED_OUTCOMES:
            continue
        at = outcome_time(entry)
        if at < horizon:
            continue
        key = health_key(entry["provider"], entry["model"])
        events.setdefault(key, []).append((at, str(entry.get("id") or ""), outcome, entry.get("quota") is True))
    state = {}
    for key, items in events.items():
        level = until = last_success = quota_until = 0
        thread_id = None
        for at, thread, outcome, is_quota in sorted(items):
            if outcome == "completed":
                level = until = quota_until = 0
                last_success = at
                continue
            if at >= until:
                level += 1
            step_until = at + backoff_seconds(level, quota=is_quota)
            until = max(until, step_until)
            if is_quota:
                quota_until = max(quota_until, step_until)
            thread_id = thread
        quota = quota_until == until and quota_until > 0
        reason = f"quota cooldown, {level} consecutive failure(s)" if quota else f"{level} consecutive failure(s)"
        state[key] = {"until": until, "level": level, "reason": reason, "quota": quota,
                      "thread_id": thread_id, "last_success": last_success}
    # Explicit cooldowns are cleared by any success in the ledger, not just outcomes within 48 hours.
    successes = latest_success_at(ledger)
    for key, cd in (ledger.get("cooldowns") or {}).items():
        # Legacy cooldowns keyed by route|alias have no provider field; they no longer apply and are pruned once expired.
        if not isinstance(cd, dict) or "provider" not in cd:
            continue
        current = state.setdefault(
            key, {"until": 0, "level": 0, "reason": None, "thread_id": None, "last_success": 0, "quota": False})
        if max(current["last_success"], successes.get(key, 0)) > int(cd.get("since") or 0):
            continue
        if int(cd.get("until") or 0) > current["until"]:
            current.update(until=int(cd["until"]), reason=LEGACY_COOLDOWN_REASONS.get(cd.get("reason"), cd.get("reason")),
                           thread_id=None, quota=bool(cd.get("quota")))
    cooled = {}
    for key, value in state.items():
        if value["until"] > now:
            provider, model = key.split("|", 1)
            cooled[key] = {"provider": provider, "model": model, "reason": value["reason"], "quota": bool(value.get("quota")),
                           "level": value["level"], "until": value["until"], "thread_id": value["thread_id"]}
    return cooled


def thread_completed(thread):
    """Only the structured status from bb thread list counts: idle, no queued work and no pending interaction means done."""
    return (thread.get("status") == "idle" and thread.get("queuedWork", "none") == "none"
            and not thread.get("hasPendingInteraction"))


def awaiting_outcome(entry):
    """Entries still awaiting an outcome: never finished, or succeeded and then errored and are retrying in the original session."""
    outcome = entry.get("outcome") or "spawned"
    return outcome == "spawned" or (int(entry.get("retries") or 0) > 0 and outcome not in FAILED_OUTCOMES)


def reconcile_outcomes(ledger, call, now):
    """Mark recent ledger entries still awaiting an outcome whose threads have finished as completed.

    Errors are not recorded as failures here: --on-failure first retries in the original session, and only
    exhausted retries record a failure. Mutates only the given ledger and returns the changes; when thread
    status cannot be read it warns and returns an empty list without blocking dispatch.
    """
    try:
        pending = {
            entry["id"]: entry for entry in ledger.get("entries") or []
            if isinstance(entry, dict) and entry.get("id") and awaiting_outcome(entry)
            and int(entry.get("ts") or 0) >= now - RECENT_WINDOW_SECONDS
        }
        if not pending:
            return []
        threads = call("thread", "list")
        if not isinstance(threads, list):
            raise DispatchError("bb thread list returned an unknown format")
        updates = []
        for thread in threads:
            entry = pending.get(thread.get("id")) if isinstance(thread, dict) else None
            if entry is None or not thread_completed(thread):
                continue
            # updatedAt is no earlier than this finish; archiving and similar actions push it later.
            updated = thread.get("updatedAt")
            at = min(now, int(updated) // 1000) if isinstance(updated, (int, float)) else now
            updates.append({"id": entry["id"], "outcome": "completed", "outcome_ts": at})
    except Exception as exc:
        print(f"warning: cannot read thread status, completions not recorded this time (continuing): {exc}", file=sys.stderr)
        return []
    for update in updates:
        pending[update["id"]].update(outcome=update["outcome"], outcome_ts=update["outcome_ts"])
    return updates


def record_outcome_command(args, now=None):
    if not args.outcome:
        raise DispatchError("--record-outcome requires --outcome.")
    target_id = string(args.record_outcome, "--record-outcome")
    now = int(time.time() if now is None else now)
    recorded = {}

    def apply(ledger):
        matched = next((entry for entry in ledger.get("entries", [])
                        if isinstance(entry, dict) and entry.get("id") == target_id), None)
        if matched is None:
            raise DispatchError(f"thread {target_id!r} not found in the ledger live window; refusing to write back an unknown ID.")
        events = []
        if args.outcome != (matched.get("outcome") or "spawned"):
            matched["outcome"], matched["outcome_ts"] = args.outcome, now
            if args.outcome in FAILED_OUTCOMES:
                events.append(cooled_event(ledger, matched, "manual", now, int(matched.get("retries") or 0)))
        matched["updated_ts"] = now
        forget_cleared_cooldowns(ledger)
        recorded.update(matched)
        return events

    update_ledger(ledger_path_from(args), apply, strict=True)
    return {"recorded": True, "entry": recorded}


def cooled_event(ledger, entry, reason, now, retries):
    """Review event after recording a failure: this cooldown's level and end time, and how many original-session retries this fault had."""
    cooldown = health_cooldowns(ledger, now).get(health_key(entry.get("provider"), entry.get("model"))) or {}
    return {"ts": now, "event": "cooled", "thread": entry.get("id"), "provider": entry.get("provider"),
            "model": entry.get("model"), "reason": reason, "retries": retries,
            "level": cooldown.get("level"), "until": cooldown.get("until")}


def recovered_event(entry, retries, now):
    """Review event for a thread that succeeded after original-session retries; retries is how many were scheduled for this fault."""
    return {"ts": now, "event": "recovered", "thread": entry.get("id"), "provider": entry.get("provider"),
            "model": entry.get("model"), "retries": retries}


def turns_ended_since(call, thread_id, since):
    """Statuses of turns that ended after since (seconds) in the thread log, in order."""
    events = call("thread", "log", thread_id, "--all")
    if not isinstance(events, list):
        raise DispatchError("bb thread log returned an unknown format")
    return [(event.get("data") or {}).get("status") for event in events
            if isinstance(event, dict) and event.get("type") == "turn/completed"
            and int(event.get("createdAt") or 0) >= since * 1000]


def json_object(text):
    """Extract the first JSON object from text; anything that does not parse counts as no structured fields."""
    if not isinstance(text, str) or "{" not in text:
        return None
    try:
        value = json.loads(text[text.find("{") :])
    except ValueError:
        return None
    return value if isinstance(value, dict) else None


def payload_has_quota_code(payload):
    """Only code, status, type and the error object are inspected, never the message sentence."""
    if not isinstance(payload, dict):
        return False
    for field in QUOTA_CODE_FIELDS:
        value = payload.get(field)
        if isinstance(value, str) and value.strip().casefold() in QUOTA_CODES:
            return True
        if payload_has_quota_code(json_object(value) if isinstance(value, str) else None):
            return True
    error = payload.get("error")
    if isinstance(error, dict) and payload_has_quota_code(error):
        return True
    if isinstance(error, str) and payload_has_quota_code(json_object(error)):
        return True
    return False


def looks_like_http_429(detail, error_info, payload):
    if isinstance(error_info, dict) and error_info.get("httpStatusCode") == 429:
        return True
    head = detail.lstrip() if isinstance(detail, str) else ""
    if head.startswith("429") and (len(head) == 3 or not head[3].isdigit()):
        return True
    if not isinstance(payload, dict):
        return False
    if any(payload.get(field) == 429 for field in ("code", "status", "httpStatusCode")):
        return True
    error = payload.get("error")
    return isinstance(error, dict) and any(error.get(field) == 429 for field in ("code", "status"))


def provider_error_is_quota(event):
    data = event.get("data") if isinstance(event.get("data"), dict) else event
    if not isinstance(data, dict):
        return False
    detail = data.get("detail") if isinstance(data.get("detail"), str) else ""
    payload = json_object(detail)
    if not looks_like_http_429(detail, data.get("errorInfo"), payload):
        return False
    return payload_has_quota_code(payload)


def current_failure_events(events):
    """Log of the current fault: events after the last successful turn. Earlier quota errors do not count."""
    last_success_at = 0
    for event in events or []:
        if not isinstance(event, dict) or event.get("type") != "turn/completed":
            continue
        if (event.get("data") or {}).get("status") != "completed":
            continue
        last_success_at = max(last_success_at, int(event.get("createdAt") or 0))
    return [event for event in events or [] if isinstance(event, dict) and int(event.get("createdAt") or 0) >= last_success_at]


def quota_classified(diagnostic, events):
    decision = diagnostic.get("decision") if isinstance(diagnostic, dict) else None
    if isinstance(decision, dict) and decision.get("kind") == "decline" and decision.get("reason") in QUOTA_DECLINE_REASONS:
        return True
    return any(event.get("type") == "provider/error" and provider_error_is_quota(event) for event in current_failure_events(events))


def quota_window_reset(diagnostic, events, now):
    """Reset time (seconds) of the subscription quota window. model_cooldown's reset_seconds is not this window."""
    resets = []
    availability = diagnostic.get("availability") if isinstance(diagnostic, dict) else None
    if isinstance(availability, dict) and availability.get("kind") == "blocked":
        retry_at = availability.get("retryAt")
        if isinstance(retry_at, (int, float)):
            resets.append(int(retry_at) // 1000)
    for event in events or []:
        if not isinstance(event, dict) or event.get("type") != "provider/rateLimits/updated":
            continue
        data = event.get("data") if isinstance(event.get("data"), dict) else event
        limits = data.get("rateLimits") if isinstance(data, dict) else None
        if not isinstance(limits, dict) or limits.get("kind") != "subscription-window" or limits.get("status") != "blocked":
            continue
        for window in limits.get("windows") or []:
            if not isinstance(window, dict) or window.get("status") != "blocked":
                continue
            if isinstance(window.get("resetsAtMs"), (int, float)):
                resets.append(int(window["resetsAtMs"]) // 1000)
    future = [item for item in resets if item > now]
    return max(future) if future else None


def on_failure_command(args, call=bb, now=None):
    """Called by the parent after a child errors: retry in the original session with backoff first, and only
    record a failure and cool that provider and model once retries are exhausted.

    Quota is recognized only from provider-retry decline reasons and structured error codes on HTTP 429;
    otherwise original-session retries continue. Error sentences are never scanned. Queued messages on an
    errored thread are sent only when it is retried, so the queue count is not treated as an existing retry.
    """
    target_id = string(args.on_failure, "--on-failure")
    now = int(time.time() if now is None else now)
    lpath = ledger_path_from(args)

    def find(ledger):
        entry = next((item for item in ledger.get("entries", [])
                      if isinstance(item, dict) and item.get("id") == target_id), None)
        if entry is None:
            raise DispatchError(f"thread {target_id!r} not found in the ledger live window; only threads dispatched by bb-dispatch are handled.")
        return entry

    def optional(*command):
        # When the BB automatic retry plugin is unavailable, treat it as no verdict and keep original-session retries going.
        try:
            value = call(*command)
        except DispatchError:
            return {}
        return value if isinstance(value, dict) else {}

    def waiting(why):
        return {"action": "waiting", "message": f"{why}; end the turn and wait for the notification."}

    ledger = load_ledger(lpath, strict=True)
    entry = find(ledger)
    target = f"{entry.get('provider')}/{entry.get('model')}"
    shown = mapping(call("thread", "show", target_id), "thread")
    thread = shown.get("thread") if isinstance(shown.get("thread"), dict) else shown
    if thread.get("status") != "error":
        return {"action": "not-failed", "status": thread.get("status"), "message": "thread is not in error state; keep waiting for the notification as usual."}
    if optional("provider-retry", "status", target_id).get("retries"):
        if not args.dry_run:
            with ledger_lock(lpath):
                append_events(lpath, [{"ts": now, "event": "deferred", "thread": target_id,
                                       "provider": entry.get("provider"), "model": entry.get("model")}])
        return waiting("a BB automatic retry is already queued")

    def cooled(reason, data):
        result = {"action": "cooled", "reason": reason,
                  "message": f"{reason}; recorded as failed and cooled {target}. Rerun bb-dispatch with the original difficulty and full task text (or --redispatch) to switch candidates."}
        cooldown = health_cooldowns(data, now).get(health_key(entry.get("provider"), entry.get("model")))
        if cooldown:
            result["cooldown"] = {**cooldown, "remaining_seconds": cooldown["until"] - now}
        return result

    if (entry.get("outcome") or "spawned") in FAILED_OUTCOMES:
        return cooled("thread already recorded as failed", ledger)
    retries = int(entry.get("retries") or 0)
    recovered = False
    if retries:
        # Retries run at least 1 minute later, so clock skew between this host and BB cannot pull in turns from before scheduling.
        ended = turns_ended_since(call, target_id, int(entry.get("retry_ts") or 0))
        if ended == []:
            return waiting("the previously scheduled original-session retry has not run yet")
        # A success since the last scheduled retry means that fault recovered; this is a new fault, counted from scratch.
        recovered = "completed" in ended
    attempt = 1 if recovered else retries + 1
    events = [recovered_event(entry, retries, now)] if recovered else []
    diagnostic = optional("provider-retry", "explain", target_id).get("diagnostic")
    if not isinstance(diagnostic, dict):
        diagnostic = {}
    try:
        logged = call("thread", "log", target_id, "--all")
    except DispatchError:
        logged = None
    if not isinstance(logged, list):
        logged = None
    decision = diagnostic.get("decision") if isinstance(diagnostic, dict) else None
    quota = quota_classified(diagnostic, logged)
    reset = quota_window_reset(diagnostic, logged, now) if quota else None
    if quota:
        code, reason = "quota", "quota exhausted"
    elif isinstance(decision, dict) and decision.get("kind") == "decline" and decision.get("reason") in BB_RETRY_GAVE_UP:
        code, reason = "bb-gave-up", "BB already retried to its limit in the original session"
    elif attempt > SESSION_RETRY_LIMIT:
        code, reason = "exhausted", f"still failing after {SESSION_RETRY_LIMIT} original-session retries"
    else:
        delay = SESSION_RETRY_BASE_SECONDS * 2 ** (attempt - 1)
        result = {"action": "retry-scheduled", "attempt": attempt, "limit": SESSION_RETRY_LIMIT, "delay_seconds": delay,
                  "message": f"scheduled original-session retry {attempt}/{SESSION_RETRY_LIMIT} in {delay // 60} minute(s); end the turn and wait for the notification."}
        if args.dry_run:
            return {"dry_run": True, **result}
        try:
            call("thread", "retry", target_id, "--send-at", f"{delay}s",
                 "--reason", f"bb-dispatch original-session retry {attempt}/{SESSION_RETRY_LIMIT}")
        except DispatchError as exc:
            if exc.code == "retry_already_queued":
                return waiting("this turn already has a queued retry")
            code, reason = "retry-impossible", f"cannot retry in the original session ({exc})"
        else:
            def mark_retry(data):
                matched = find(data)
                # Leave the outcome alone: a thread that succeeded keeps that success, which still resets the cooldown.
                matched["retries"], matched["retry_ts"], matched["updated_ts"] = attempt, now, now
                return [*events, {"ts": now, "event": "retry", "thread": target_id, "provider": matched.get("provider"),
                                  "model": matched.get("model"), "attempt": attempt, "delay": delay}]
            update_ledger(lpath, mark_retry, strict=True)
            return result
    if args.dry_run:
        return {"dry_run": True, "action": "cooled", "reason": reason}

    def mark_failed(data):
        matched = find(data)
        matched["outcome"], matched["outcome_ts"], matched["updated_ts"] = "failed", now, now
        matched["retries"] = attempt - 1
        if code == "quota":
            matched["quota"] = True
            computed = health_cooldowns(data, now).get(health_key(matched.get("provider"), matched.get("model"))) or {}
            if reset and reset > int(computed.get("until") or 0):
                set_quota_window(data, matched.get("provider"), matched.get("model"), now, reset)
        return [*events, cooled_event(data, matched, code, now, attempt - 1)]
    return cooled(reason, update_ledger(lpath, mark_failed, strict=True))


def summarize_ledger(ledger, now=None):
    now = int(time.time() if now is None else now)
    by_difficulty = {d: {"total": 0, "failed": 0} for d in ROUTES}
    by_agent = {}

    def ensure_agent(agent):
        if agent not in by_agent:
            by_agent[agent] = {"total": 0, "outcomes": {k: 0 for k in OUTCOME_KEYS}}
        return by_agent[agent]

    def add(diff, agent, total, outcomes):
        if diff in by_difficulty:
            by_difficulty[diff]["total"] += total
            by_difficulty[diff]["failed"] += sum(int(outcomes.get(k, 0)) for k in FAILED_OUTCOMES)
        ag = ensure_agent(agent or "unknown")
        ag["total"] += total
        for k in OUTCOME_KEYS:
            ag["outcomes"][k] += int(outcomes.get(k, 0))

    rolled_up_count = 0
    for bucket in (ledger.get("rollups") or {}).values():
        if not isinstance(bucket, dict):
            continue
        total = int(bucket.get("total", 0))
        rolled_up_count += total
        add(bucket.get("difficulty"), bucket.get("agent"), total, bucket.get("outcomes") or {})

    live_entries = [e for e in (ledger.get("entries") or []) if isinstance(e, dict)]
    for entry in live_entries:
        add(entry.get("difficulty"), entry.get("agent"), 1, {entry.get("outcome") or "spawned": 1})

    total_dispatches = rolled_up_count + len(live_entries)
    for diff, stats in by_difficulty.items():
        stats["share"] = round(stats["total"] / total_dispatches, 4) if total_dispatches else 0.0

    hooks = []
    for agent, ag in sorted(by_agent.items()):
        total = ag["total"]
        failed = sum(ag["outcomes"][k] for k in FAILED_OUTCOMES)
        ag["failed"] = failed
        ag["failure_rate"] = round(failed / total, 4) if total else 0.0
        if total >= 3 and ag["failure_rate"] >= 0.30:
            hooks.append({
                "hook": "high_failure_rate",
                "agent": agent,
                "numerator": failed,
                "denominator": total,
                "message": f"candidate {agent} failure rate {failed}/{total} (>=30%); check its quota or service stability.",
            })

    active_cooldowns = [
        {**cd, "remaining_seconds": cd["until"] - now}
        for _, cd in sorted(health_cooldowns(ledger, now).items())
    ]

    return {
        "total_dispatches": total_dispatches,
        "live_entries": len(live_entries),
        "rolled_up_entries": rolled_up_count,
        "by_difficulty": by_difficulty,
        "by_agent": by_agent,
        "active_cooldowns": active_cooldowns,
        "review_hooks": hooks,
    }


def summarize_events(ledger_path, now, days=7):
    """Summarize recent dispatches, original-session retries and cooldowns from the review log: whether retries
    work, whether cooldowns are frequent, and whether the trend looks normal."""
    counters = {"dispatch": "dispatches", "deferred": "deferred_to_bb", "retry": "retries",
                "recovered": "recovered", "cooled": "cooled"}
    totals = dict.fromkeys(("dispatches", "diverted_dispatches", "quota_cooldown_skips", "deferred_to_bb", "retries",
                            "recovered", "cooled", "retried_then_cooled"), 0)
    recovered_by_attempt, cooled_by_reason, by_target, daily = {}, {}, {}, {}
    try:
        lines = events_path(ledger_path).read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        key = counters.get(event.get("event")) if isinstance(event, dict) else None
        if key is None or int(event.get("ts") or 0) < now - days * 86400:
            continue
        day = daily.setdefault(time.strftime("%Y-%m-%d", time.localtime(int(event["ts"]))), dict.fromkeys(totals, 0))
        target = by_target.setdefault(f"{event.get('provider')}|{event.get('model')}",
                                      {**dict.fromkeys(counters.values(), 0), "max_level": 0})
        for bucket in (totals, day, target):
            bucket[key] += 1
        if event.get("diverted"):
            totals["diverted_dispatches"] += 1
            day["diverted_dispatches"] += 1
        skips = int(event.get("quota_diverted") or 0)
        if skips:
            totals["quota_cooldown_skips"] += skips
            day["quota_cooldown_skips"] += skips
        if key == "recovered":
            attempt = str(event.get("retries"))
            recovered_by_attempt[attempt] = recovered_by_attempt.get(attempt, 0) + 1
        if key == "cooled":
            reason = str(event.get("reason"))
            cooled_by_reason[reason] = cooled_by_reason.get(reason, 0) + 1
            target["max_level"] = max(target["max_level"], int(event.get("level") or 0))
            if int(event.get("retries") or 0) > 0:
                totals["retried_then_cooled"] += 1
    # A fault retried in the original session ends one of two ways: recovered, or finally cooled.
    ended = totals["recovered"] + totals["retried_then_cooled"]
    return {"window_days": days, **totals,
            "retry_recovery_rate": round(totals["recovered"] / ended, 4) if ended else None,
            "recovered_by_attempt": recovered_by_attempt, "cooled_by_reason": cooled_by_reason,
            "by_target": by_target, "daily": [{"date": date, **counts} for date, counts in sorted(daily.items())]}


def followups_command(args, call=bb, now=None):
    """Messages the parent or user added after the first delivery of recently dispatched threads; text is only
    printed, never written to the ledger."""
    now = int(time.time() if now is None else now)
    since = now - args.days * 86400
    dispatched, redispatched = {}, {}
    try:
        lines = events_path(ledger_path_from(args)).read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict) or event.get("event") != "dispatch":
            continue
        if event.get("escalated_from"):
            redispatched.setdefault(event["escalated_from"], []).append(event.get("thread"))
        if int(event.get("ts") or 0) >= since:
            dispatched[event.get("thread")] = event
    threads = call("thread", "list", "--include-hidden", "--include-archived")
    if not isinstance(threads, list):
        raise DispatchError("bb thread list returned an unknown format")
    parents = {t.get("id"): t.get("parentThreadId") for t in threads if isinstance(t, dict)}
    titles = {t.get("id"): t.get("title") for t in threads if isinstance(t, dict)}
    rows, unreadable = [], []
    for thread_id, event in sorted(dispatched.items(), key=lambda kv: kv[1].get("ts") or 0):
        try:
            log = call("thread", "log", thread_id, "--all")
        except DispatchError:
            unreadable.append(thread_id)
            continue
        # Only a normally completed turn counts as delivery; a manually stopped turn ends as interrupted.
        delivered, stopped, followups = False, False, []
        for item in log if isinstance(log, list) else []:
            kind, data = item.get("type"), item.get("data") or {}
            if kind == "turn/completed" and data.get("status") == "completed":
                delivered = True
            elif kind == "system/thread/interrupted" and data.get("reason") == "manual-stop" and not delivered:
                stopped = True
            elif kind == "client/turn/requested" and delivered:
                initiator = data.get("initiator")
                text = "".join(part.get("text", "") for part in data.get("input") or [] if isinstance(part, dict))
                from_parent = initiator == "agent" and data.get("senderThreadId") == parents.get(thread_id)
                if (from_parent or initiator == "user") and not text.lstrip().startswith(NOTICE_PREFIXES):
                    followups.append({"seq": item.get("seq"), "from": "parent" if from_parent else "user",
                                      "text": text.strip()[:FOLLOWUP_TEXT_MAX_CHARS]})
        rows.append({"thread": thread_id, "title": titles.get(thread_id), "parent": parents.get(thread_id),
                     "delivered": delivered, "stopped_before_delivery": stopped,
                     "redispatched_as": redispatched.get(thread_id, []),
                     **{k: event.get(k) for k in ("difficulty", "agent", "model")}, "followups": followups})
    by_agent = {}
    for row in rows:
        stats = by_agent.setdefault(row["agent"], {"threads": 0, "delivered": 0, "stopped_before_delivery": 0,
                                                   "redispatched": 0, "with_followups": 0, "followups": 0})
        stats["threads"] += 1
        stats["delivered"] += row["delivered"]
        stats["stopped_before_delivery"] += row["stopped_before_delivery"]
        stats["redispatched"] += bool(row["redispatched_as"])
        stats["with_followups"] += bool(row["followups"])
        stats["followups"] += len(row["followups"])
    return {"window_days": args.days, "threads": len(rows), "unreadable": unreadable,
            "by_agent": by_agent, "rows": rows}


def candidate_chain(args, defaults, route):
    value = defaults.get(route)
    if isinstance(value, str):
        chain, mode, weights = [value], "fallback", None
    elif isinstance(value, list) and value:
        chain, mode, weights = value, "fallback", None
    elif isinstance(value, dict):
        unknown = set(value) - {"mode", "candidates"}
        if unknown:
            raise DispatchError(f"defaults.{route} route config has unknown keys: {sorted(unknown)}.")
        mode = string(value.get("mode"), f"defaults.{route}.mode")
        if mode not in ("fallback", "load-balance", "weighted-load-balance"):
            raise DispatchError(
                f"defaults.{route}.mode must be fallback, load-balance or weighted-load-balance."
            )
        candidates = value.get("candidates")
        if mode == "weighted-load-balance":
            if not isinstance(candidates, dict) or not candidates:
                raise DispatchError(f"defaults.{route}.candidates must be a non-empty alias: weight mapping.")
            chain, weights = [], {}
            for raw_alias, weight in candidates.items():
                alias = string(raw_alias, f"defaults.{route} candidate alias")
                if isinstance(weight, bool) or not isinstance(weight, (int, float)) or not math.isfinite(weight) or weight < 0:
                    raise DispatchError(f"defaults.{route}.candidates.{alias} weight must be a finite number >= 0.")
                if weight == 0:
                    continue
                chain.append(alias)
                weights[alias] = weight
            if not chain:
                raise DispatchError(f"defaults.{route}.candidates needs at least one candidate with weight > 0.")
        else:
            if not isinstance(candidates, list) or not candidates:
                raise DispatchError(f"defaults.{route}.candidates must be a non-empty alias list.")
            chain, weights = candidates, None
    else:
        raise DispatchError(f"defaults.{route} must be a non-empty alias, an ordered alias list or a route config.")
    chain = [string(item, f"defaults.{route} candidate") for item in chain]
    if len(set(chain)) != len(chain):
        raise DispatchError(f"defaults.{route} candidate aliases must not repeat.")
    weights = weights or {alias: 1 for alias in chain}
    if mode in ("load-balance", "weighted-load-balance"):
        # Deterministic rendezvous ordering spreads independent tasks without mutable state.
        # Exponential races extend it to weighted selection while preserving a stable fallback order.
        key = f"{route}\0{args.task}".encode()
        if mode == "load-balance":
            chain = sorted(
                chain,
                key=lambda alias: hashlib.sha256(key + b"\0" + alias.encode()).digest(),
                reverse=True,
            )
        else:
            def weighted_score(alias):
                digest = hashlib.sha256(key + b"\0" + alias.encode()).digest()
                uniform = (int.from_bytes(digest) + 1) / (2 ** 256 + 1)
                return -math.log(uniform) / weights[alias]
            chain = sorted(chain, key=weighted_score)
    full_chain = list(chain)
    if args.fallback_from is not None:
        start = string(args.fallback_from, "--fallback-from")
        if start not in chain:
            raise DispatchError(f"--fallback-from {start!r} is not among defaults.{route} candidates {chain}.")
        chain = chain[chain.index(start):]
    return chain, mode, {alias: weights[alias] for alias in chain}, full_chain


def model_and_reasoning(agent, alias, route):
    if "model" in agent or "reasoning" in agent:
        raise DispatchError(f"model/reasoning of agents.{alias} must be under routes.<route>.")
    routes = mapping(agent.get("routes"), f"agents.{alias}.routes")
    unknown = [repr(key) for key in routes if key not in ROUTE_KEYS]
    if unknown:
        raise DispatchError(f"agents.{alias}.routes only supports {sorted(ROUTE_KEYS)}; unknown keys: {', '.join(unknown)}.")
    profile_name = next((key for key in (route, "default") if key in routes), None)
    if profile_name is None:
        raise DispatchError(f"agents.{alias}.routes lacks {route!r} or 'default'; this candidate does not take part in this route.")
    profile = mapping(routes[profile_name], f"agents.{alias}.routes.{profile_name}")
    model = string(profile.get("model"), f"agents.{alias}.routes.{profile_name}.model")
    reasoning = profile.get("reasoning")
    if reasoning is not None:
        reasoning = string(reasoning, f"agents.{alias}.routes.{profile_name}.reasoning")
    return model, reasoning


def resolve_escalation(args, call):
    redispatch = getattr(args, "redispatch", None)
    flag = "--redispatch" if redispatch is not None else "--escalate-from"
    source_id = redispatch if redispatch is not None else getattr(args, "escalate_from", None)
    if source_id is None:
        return None
    source_id = string(source_id, flag)
    shown = mapping(call("thread", "show", source_id), f"{flag} thread")
    thread = shown.get("thread") if isinstance(shown.get("thread"), dict) else shown
    if thread.get("id") and thread["id"] != source_id:
        raise DispatchError(f"{flag} thread {source_id!r} failed verification.")
    if redispatch is not None:
        restore_redispatch(args, call, source_id, thread)
    return source_id


def restore_redispatch(args, call, source_id, thread):
    if args.difficulty is not None or args.task is not None or args.escalate_from is not None:
        raise DispatchError("--redispatch restores the original purpose, difficulty and task; it cannot be combined with --difficulty, --task or --escalate-from.")
    ledger = load_ledger(ledger_path_from(args), strict=True)
    entry = next((item for item in ledger["entries"]
                  if isinstance(item, dict) and item.get("id") == source_id), {})
    difficulty = entry.get("requested_difficulty", entry.get("difficulty"))
    if difficulty not in ROUTES:
        raise DispatchError(f"the run ledger has no valid original difficulty for thread {source_id!r}.")

    events = call("thread", "log", source_id, "--all")
    if not isinstance(events, list):
        raise DispatchError("bb thread log returned an unknown format.")
    first = next((event for event in events if isinstance(event, dict)
                  and event.get("type") == "client/turn/requested"), {})
    data = first.get("data")
    parts = data.get("input") if isinstance(data, dict) and data.get("source") == "spawn" else None
    if not isinstance(parts, list) or not parts or any(
        not isinstance(part, dict) or part.get("type") != "text" or not isinstance(part.get("text"), str)
        for part in parts
    ):
        raise DispatchError(f"the log of thread {source_id!r} has no recoverable first-turn dispatch task text.")

    args.task = "".join(part["text"] for part in parts)
    args.difficulty = difficulty
    if entry.get("purpose") in PURPOSES:
        args.purpose = entry["purpose"]
    if difficulty == ADVISOR_ROUTE:
        args.purpose = "advise"
        # A named advisor stays named: redispatch retries it rather than picking another advisor.
        if getattr(args, "advisor", None) is None and isinstance(entry.get("advisor"), str):
            args.advisor = entry["advisor"]
        if getattr(args, "advisor", None) is not None and args.fallback_from is not None:
            raise DispatchError("--fallback-from cannot be combined with a named advisor.")
    if args.environment is None:
        args.environment = string(thread.get("environmentId"), "original thread environment ID")
    args.parent_notifications = args.parent_notifications or thread.get("parentNotifications")


# Independent of --ledger/--config: dispatch processes of the same OS user share the lock and pending reservations.
CONCURRENCY_PATH = Path.home() / ".cache/bb-dispatch/concurrency.json"
CONCURRENCY_LOCK_WAIT_SECONDS = 10


@contextlib.contextmanager
def concurrency_lock():
    """Capacity control cannot fail open like the statistics ledger. The lock covers one dispatch, not the task's lifetime."""
    if fcntl is None:
        raise DispatchError("concurrency limits need an fcntl file lock, which this platform lacks.")
    handle = None
    try:
        CONCURRENCY_PATH.parent.mkdir(parents=True, exist_ok=True)
        handle = open(CONCURRENCY_PATH.with_suffix(".lock"), "a")
        deadline = time.monotonic() + CONCURRENCY_LOCK_WAIT_SECONDS
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise DispatchError("concurrency dispatch lock is busy; retry later. No thread was created.")
                time.sleep(0.05)
        yield
    except OSError as exc:
        raise DispatchError(f"cannot access concurrency state: {exc}") from exc
    finally:
        if handle is not None:
            handle.close()


class ConcurrencySlots:
    def __init__(self, call, read_only=False):
        self.call, self.read_only = call, read_only
        self.threads = None
        try:
            data = json.loads(CONCURRENCY_PATH.read_text()) if CONCURRENCY_PATH.exists() else {"version": 1, "reservations": []}
            self.reservations = data["reservations"]
            if data.get("version") != 1 or not isinstance(self.reservations, list):
                raise ValueError("invalid concurrency state format")
            for item in self.reservations:
                if (not isinstance(item, dict) or not isinstance(item.get("id"), str)
                        or not isinstance(item.get("provider"), str) or not isinstance(item.get("ts"), int)
                        or (item.get("thread") is not None and not isinstance(item["thread"], str))
                        or (item.get("model") is not None and not isinstance(item["model"], str))):
                    raise ValueError("invalid concurrency reservation fields")
        except (OSError, ValueError, KeyError, TypeError) as exc:
            raise DispatchError(f"cannot read concurrency state {CONCURRENCY_PATH}: {exc}") from exc

    def save(self):
        if self.read_only:
            return
        try:
            tmp = CONCURRENCY_PATH.with_suffix(".tmp")
            tmp.write_text(json.dumps({"version": 1, "reservations": self.reservations}, ensure_ascii=False, indent=2))
            tmp.replace(CONCURRENCY_PATH)
        except OSError as exc:
            raise DispatchError(f"cannot save concurrency state: {exc}") from exc

    @staticmethod
    def occupied(thread):
        # Archiving stops the queue from dispatching; leftover messages and interactions no longer reserve capacity.
        if thread.get("archivedAt") is not None:
            return False
        if thread.get("hasPendingInteraction") is not False:
            return True
        # Ordinary queued messages on an error thread wait for a retry and are not running; unknown queue states
        # still count conservatively. Original-session/automatic retries bypass the create path and are counted
        # from live status once they start.
        if thread.get("status") == "error":
            return thread.get("queuedWork") not in ("none", "waiting", "failed")
        return not (thread.get("status") == "idle" and thread.get("queuedWork") == "none")

    def refresh(self):
        if self.threads is not None:
            return
        rows = self.call("thread", "list", "--include-hidden", "--include-archived")
        if not isinstance(rows, list) or any(not isinstance(t, dict) or not t.get("id") for t in rows):
            raise DispatchError("cannot determine concurrency: bb thread list returned an unknown format.")
        self.threads = {t["id"]: t for t in rows}
        keep = []
        for item in self.reservations:
            thread = self.threads.get(item.get("thread"))
            # Unknown creation results and not-yet-visible threads keep their reservation. idle also needs a turn-end event
            # so the initial idle state does not release it early.
            if thread is not None and not self.occupied(thread):
                # Archiving alone ends dispatch eligibility; no turn/completed log is required.
                if thread.get("archivedAt") is not None or self.turn_ended(thread["id"], item["ts"]):
                    continue
            keep.append(item)
        self.reservations = keep

    def turn_ended(self, thread_id, since):
        try:
            return bool(turns_ended_since(self.call, thread_id, since))
        except DispatchError as exc:
            # BB caps a single log response at 8 MiB; an idle thread whose log is too large must have run a turn,
            # so release it as ended. Otherwise this one reservation fails the whole refresh and every route shows full.
            if exc.code == "event_data_too_large":
                return True
            raise

    def usage(self, provider, models=None):
        self.refresh()
        known = {r["thread"]: r.get("model") for r in self.reservations
                 if r["provider"] == provider and r.get("thread")}

        def included(model):
            # The BB list carries no model; new dispatches record it in the reservation. Legacy reservations and other
            # entry points with unknown models still count conservatively.
            return models is None or model is None or model in models

        active = {t["id"] for t in self.threads.values()
                  if t.get("providerId") == provider and self.occupied(t) and included(known.get(t["id"]))}
        held = [r for r in self.reservations if r["provider"] == provider and included(r.get("model"))]
        # Visible threads and reservations count once; active threads created elsewhere count too, so the provider is not overloaded.
        return len(active | {r["thread"] for r in held if r.get("thread")}) + sum(not r.get("thread") for r in held)

    def reserve(self, provider, model):
        self.refresh()
        item = {"id": uuid.uuid4().hex, "provider": provider, "model": model,
                "ts": int(time.time()), "thread": None}
        self.reservations.append(item)
        self.save()  # Persisted before spawn so crashes or timeouts still hold the slot.
        return item


def provider_limits(agents):
    limits = {}
    for alias, agent in mapping(agents, "agents").items():
        agent = mapping(agent, f"agents.{alias}")
        if "max_concurrency" not in agent:
            continue
        limit = agent["max_concurrency"]
        if type(limit) is not int or limit < 1:
            raise DispatchError(f"agents.{alias}.max_concurrency must be a positive integer; omit it for no limit.")
        provider = string(agent.get("provider"), f"agents.{alias}.provider")
        limits[provider] = min(limit, limits.get(provider, limit))
    return limits


def provider_model_scopes(agents):
    """Limited models of the same provider merge into one pool; any cap without a model list covers all models."""
    scopes = {}
    for alias, agent in mapping(agents, "agents").items():
        agent = mapping(agent, f"agents.{alias}")
        if "concurrency_models" in agent and "max_concurrency" not in agent:
            raise DispatchError(f"agents.{alias}.concurrency_models requires max_concurrency as well.")
        if "max_concurrency" not in agent:
            continue
        models = agent.get("concurrency_models")
        if "concurrency_models" in agent:
            if (not isinstance(models, list) or not models
                    or any(not isinstance(v, str) or not v.strip() or v != v.strip() for v in models)):
                raise DispatchError(f"agents.{alias}.concurrency_models must be a non-empty list of model IDs.")
            models = set(models)
        provider = string(agent.get("provider"), f"agents.{alias}.provider")
        if provider not in scopes:
            scopes[provider] = models
        elif scopes[provider] is None or models is None:
            scopes[provider] = None
        else:
            scopes[provider].update(models)
    return scopes


def concurrency_command(args, call=bb):
    def run():
        slots = ConcurrencySlots(call, read_only=not args.release_reservation)
        if args.release_reservation:
            matched = [r for r in slots.reservations if r["id"] == args.release_reservation]
            if not matched:
                raise DispatchError("unknown concurrency reservation ID; nothing changed.")
            if args.dry_run:
                return {"would_release": args.release_reservation, "dry_run": True}
            slots.reservations.remove(matched[0])
            slots.save()
            return {"released": args.release_reservation}
        slots.refresh()
        providers = sorted({t.get("providerId") for t in slots.threads.values() if t.get("providerId")}
                           | {r["provider"] for r in slots.reservations})
        return {"state_path": str(CONCURRENCY_PATH), "usage": {p: slots.usage(p) for p in providers},
                "reservations": slots.reservations}
    if args.release_reservation:
        with concurrency_lock():
            return run()
    return run()


# Temporary routing overlays: a user-requested route change scoped to one parent thread, layered over the
# main config without editing it. Only defaults and agents can be overridden; everything else (projects,
# permissions, notifications, fast) still comes from the main config.
OVERLAY_ROUTING_KEYS = ("defaults", "agents")
OVERLAY_META_KEYS = ("thread", "note", "created_at", "expires_at")
OVERLAY_DEFAULT_HOURS = 24


def overlay_dir():
    return Path(os.environ.get("BB_DISPATCH_OVERLAY_DIR", str(Path.home() / ".config/bb-dispatch/overlays"))).expanduser()


def overlay_path(thread):
    thread = string(thread, "overlay thread")
    if not all(ch.isalnum() or ch in "_-" for ch in thread):
        raise DispatchError(f"invalid thread ID for an overlay: {thread!r}.")
    return overlay_dir() / f"{thread}.yaml"


def iso_time(ts):
    return datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).isoformat(timespec="seconds")


def parse_overlay(body, where):
    body = mapping(body, where)
    unknown = sorted(set(body) - set(OVERLAY_ROUTING_KEYS) - set(OVERLAY_META_KEYS))
    if unknown:
        raise DispatchError(f"{where} only overrides defaults and agents; unknown keys: {unknown}.")
    defaults = mapping(body.get("defaults", {}), f"{where} defaults")
    bad = sorted(set(defaults) - set(ROUTES))
    if bad:
        raise DispatchError(f"{where} defaults only takes {', '.join(ROUTES)}; got {bad}.")
    agents = mapping(body.get("agents", {}), f"{where} agents")
    if not defaults and not agents:
        raise DispatchError(f"{where} must set defaults or agents.")
    return body


def overlay_expiry(body, where):
    try:
        return int(datetime.datetime.fromisoformat(string(body.get("expires_at"), f"{where} expires_at")).timestamp())
    except ValueError as exc:
        raise DispatchError(f"{where} expires_at is not an ISO time: {exc}") from exc


def read_overlay(path):
    try:
        raw = yaml.safe_load(path.read_text())
    except (OSError, yaml.YAMLError) as exc:
        raise DispatchError(f"cannot read overlay {path}: {exc}") from exc
    body = parse_overlay(raw, f"overlay {path}")
    return body, overlay_expiry(body, f"overlay {path}")


def load_overlay(now):
    """Active overlay for the current BB thread, or None. An unreadable overlay fails the dispatch rather than silently routing by the main config."""
    thread = os.environ.get("BB_THREAD_ID")
    if not thread:
        return None
    path = overlay_path(thread)
    if not path.exists():
        return None
    body, expires = read_overlay(path)
    info = {"path": str(path), "thread": thread, "note": body.get("note"), "expires_at": iso_time(expires),
            "overrides": [f"defaults.{k}" for k in body.get("defaults", {})] + [f"agents.{k}" for k in body.get("agents", {})]}
    if expires <= now:
        return {**info, "expired": True}
    return {**info, "expired": False, "defaults": body.get("defaults", {}), "agents": body.get("agents", {})}


def overlay_set_command(args, now=None):
    now = int(time.time() if now is None else now)
    thread = args.overlay_thread or os.environ.get("BB_THREAD_ID")
    if not thread:
        raise DispatchError("cannot determine the thread the overlay applies to; run inside a BB thread or pass --overlay-thread <thread-ID>.")
    if args.hours is None or args.hours <= 0:
        raise DispatchError("--hours must be a positive number.")
    source = sys.stdin.read() if args.overlay_set == "-" else Path(args.overlay_set).expanduser().read_text()
    try:
        raw = yaml.safe_load(source)
    except yaml.YAMLError as exc:
        raise DispatchError(f"overlay input is not valid YAML: {exc}") from exc
    body = parse_overlay(raw, "overlay input")
    body = {k: body[k] for k in OVERLAY_ROUTING_KEYS if k in body}
    # Check the merged routes resolve against the main config, which is only read here, never written.
    try:
        config = mapping(yaml.safe_load(Path(args.config).expanduser().read_text()), "config")
    except (OSError, yaml.YAMLError) as exc:
        raise DispatchError(f"cannot read config {args.config}: {exc}") from exc
    provider_limits(body.get("agents", {}))
    provider_model_scopes(body.get("agents", {}))
    overlay_defaults, overlay_agents = body.get("defaults", {}), body.get("agents", {})
    # Compose exactly as dispatch does: main config, then one environment block (or none, as in path mode), then
    # the overlay. Every difficulty the overlay touches must keep at least one resolvable candidate in each.
    scopes = [("main config", {})] + [
        (f"environment {env_id}", mapping(env, "environment config"))
        for env_id, env in mapping(config.get("environments", {}), "environments").items()
    ]
    probe = argparse.Namespace(task="", fallback_from=None)
    for scope, env in scopes:
        defaults = {**mapping(config.get("defaults", {}), "defaults"),
                    **mapping(env.get("defaults", {}), "environment defaults"), **overlay_defaults}
        agents = {**mapping(config.get("agents", {}), "agents"),
                  **mapping(env.get("agents", {}), "environment agents"), **overlay_agents}
        for route in ROUTES:
            if route not in defaults:
                continue
            chain = candidate_chain(probe, defaults, route)[3]
            if route not in overlay_defaults and not set(chain) & set(overlay_agents):
                continue
            missing = [alias for alias in chain if alias not in agents] if route in overlay_defaults else []
            if missing:
                raise DispatchError(f"overlay defaults.{route} names agents undefined in {scope}: {missing}; define them under overlay agents.")
            errors = []
            for alias in chain:
                try:
                    agent = mapping(agents.get(alias), f"agents.{alias}")
                    string(agent.get("provider"), f"agents.{alias}.provider")
                    model_and_reasoning(agent, alias, route)
                    break
                except DispatchError as exc:
                    errors.append(str(exc))
            else:
                raise DispatchError(f"with this overlay, defaults.{route} has no resolvable candidate in {scope}: {'; '.join(errors)}")
    expires = now + int(args.hours * 3600)
    record = {"thread": thread, "note": args.note, "created_at": iso_time(now), "expires_at": iso_time(expires), **body}
    if args.note is None:
        del record["note"]
    path = overlay_path(thread)
    if args.dry_run:
        return {"dry_run": True, "path": str(path), "overlay": record}
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f".{uuid.uuid4().hex}.tmp")
    tmp.write_text(yaml.safe_dump(record, allow_unicode=True, sort_keys=False))
    tmp.replace(path)
    pruned = []
    for other in overlay_dir().glob("*.yaml"):
        if other == path:
            continue
        try:
            if read_overlay(other)[1] <= now:
                other.unlink()
                pruned.append(other.stem)
        except (DispatchError, OSError):
            continue
    return {"set": True, "path": str(path), "overlay": record, "pruned_expired": pruned}


def overlay_show_command(now=None):
    now = int(time.time() if now is None else now)
    overlays = []
    for path in sorted(overlay_dir().glob("*.yaml")) if overlay_dir().is_dir() else []:
        try:
            body, expires = read_overlay(path)
        except DispatchError as exc:
            overlays.append({"path": str(path), "error": str(exc)})
            continue
        overlays.append({"thread": body.get("thread", path.stem), "path": str(path), "note": body.get("note"),
                         "expires_at": iso_time(expires), "active": expires > now,
                         **{k: body[k] for k in OVERLAY_ROUTING_KEYS if k in body}})
    return {"overlay_dir": str(overlay_dir()), "current_thread": os.environ.get("BB_THREAD_ID"), "overlays": overlays}


def overlay_clear_command(args):
    thread = args.overlay_clear if args.overlay_clear != "-" else os.environ.get("BB_THREAD_ID")
    if not thread:
        raise DispatchError("cannot determine which overlay to clear; pass the thread ID.")
    path = overlay_path(thread)
    if not path.exists():
        raise DispatchError(f"no overlay for thread {thread}; nothing changed.")
    if args.dry_run:
        return {"dry_run": True, "would_clear": str(path)}
    path.unlink()
    return {"cleared": str(path)}


def normalize_purpose(args):
    """Advisor dispatches route by defaults.advisor, so the advisor route takes the place of a difficulty."""
    advisor = getattr(args, "advisor", None)
    if advisor is not None and args.fallback_from is not None:
        raise DispatchError("--fallback-from cannot be combined with --advisor.")
    if args.redispatch is not None:
        return
    if advisor is not None and args.purpose != "advise":
        raise DispatchError("--advisor requires --purpose advise.")
    if args.purpose != "advise":
        return
    if args.difficulty not in (None, ADVISOR_ROUTE):
        raise DispatchError("--purpose advise routes by defaults.advisor; do not pass --difficulty.")
    args.difficulty = ADVISOR_ROUTE


def dispatch(args, call=bb, now=None):
    normalize_purpose(args)
    try:
        config = mapping(yaml.safe_load(Path(args.config).expanduser().read_text()), "config")
    except (OSError, yaml.YAMLError) as exc:
        raise DispatchError(f"cannot read config {args.config}: {exc}") from exc
    if config.get("version") != 2:
        raise DispatchError("config must contain version: 2.")
    overlay = load_overlay(int(time.time() if now is None else now))
    escalate_from = resolve_escalation(args, call)
    # Per-environment limits also decide whether to take the lock; the actual limit is computed after resolving the target environment.
    configured = bool(provider_limits(config.get("agents", {})))
    provider_model_scopes(config.get("agents", {}))
    if overlay and not overlay["expired"]:
        configured = bool(provider_limits(overlay["agents"])) or configured
        provider_model_scopes(overlay["agents"])
    for override in mapping(config.get("environments", {}), "environments").values():
        configured = bool(provider_limits(mapping(override, "environment config").get("agents", {}))) or configured
        provider_model_scopes(mapping(override, "environment config").get("agents", {}))
    if not configured:
        return dispatch_unlocked(args, call, now, config, None, escalate_from, overlay)
    if args.dry_run:
        return dispatch_unlocked(args, call, now, config, ConcurrencySlots(call, read_only=True), escalate_from, overlay)
    with concurrency_lock():
        return dispatch_unlocked(args, call, now, config, ConcurrencySlots(call), escalate_from, overlay)


def dispatch_unlocked(args, call, now, config, slots, escalate_from, overlay=None):
    now = int(time.time() if now is None else now)
    # A task copied from a child's first message drops its report protocol first, so redispatch keeps the same
    # candidate order and title.
    args.task = string(strip_report_protocol(args.task), "task")
    args.requested_difficulty = args.difficulty
    unknown = (getattr(args, "unknown", None) or "").strip()

    environment_path = Path(args.environment).expanduser() if args.environment else None
    path_mode = environment_path is not None and environment_path.is_dir()
    context = call("status") if path_mode or not (args.project and args.environment) else {}
    current_project = (context.get("project") or {}).get("id")
    current_env = ((context.get("thread") or {}).get("environment") or {}).get("display", {}).get("id")
    if path_mode:
        environment = str(environment_path.resolve())
        project = args.project or current_project
        if not project:
            raise DispatchError("path mode cannot determine the project; pass --project <id>.")
        validation_environment = current_env
        if not validation_environment:
            raise DispatchError("path mode needs a proxy environment to validate providers and models; run inside a BB thread or prepare a current environment first.")
    else:
        environment = args.environment or current_env
        if not environment:
            raise DispatchError("cannot determine the environment; pass --environment <id-or-path>.")
        env = mapping(call("environment", "show", environment), "environment")
        project = args.project or env.get("projectId") or current_project
        if not project or env.get("projectId") != project or env.get("id") != environment:
            raise DispatchError("project and environment do not match; the environment ID must exactly match an existing environment.")
        validation_environment = environment
    floor_warnings = []
    if args.purpose == "work":
        projects = mapping(config.get("projects", {}), "projects")
        project_config = mapping(projects.get(project, {}), f"projects.{project}")
        minimum = project_config.get("min_difficulty", "simple")
        if minimum not in DIFFICULTIES:
            raise DispatchError(f"projects.{project}.min_difficulty must be simple, medium or complex.")
        if DIFFICULTIES.index(args.difficulty) < DIFFICULTIES.index(minimum):
            args.difficulty = minimum
            floor_warnings.append(f"raised from {args.requested_difficulty} to {minimum} by the project floor (project {project}).")
    # Same-named aliases in an environment block replace the whole entry, so another machine's model and reasoning never mix in.
    override = {} if path_mode else mapping(
        mapping(config.get("environments", {}), "environments").get(environment, {}), "environment config"
    )
    defaults = {**mapping(config.get("defaults", {}), "defaults"), **mapping(override.get("defaults", {}), "environment defaults")}
    agents = {**mapping(config.get("agents", {}), "agents"), **mapping(override.get("agents", {}), "environment agents")}
    # A user-requested temporary overlay wins over both the main config and environment blocks for the keys it sets.
    overlay_active = bool(overlay) and not overlay["expired"]
    if overlay_active:
        defaults = {**defaults, **overlay["defaults"]}
        agents = {**agents, **overlay["agents"]}
    limits = provider_limits(agents)
    scopes = provider_model_scopes(agents)

    def limited(provider, model):
        return provider in limits and (scopes[provider] is None or model in scopes[provider])

    route = args.difficulty
    fast = configured_bool(override, config, "fast", False, "fast")
    chain, routing_mode, candidate_weights, full_chain = candidate_chain(args, defaults, route)
    advisor = getattr(args, "advisor", None)
    if advisor is not None and route != ADVISOR_ROUTE:
        raise DispatchError("--advisor only applies to advisor dispatches (--purpose advise).")
    if advisor is not None:
        # A named advisor is the user's choice: no other advisor is substituted when it is unavailable.
        if advisor not in full_chain:
            raise DispatchError(f"--advisor {advisor!r} is not among defaults.{ADVISOR_ROUTE} candidates {full_chain}.")
        chain, candidate_weights, routing_mode = [advisor], {advisor: candidate_weights.get(advisor, 1)}, "named"

    def route_target(alias):
        """(provider, model) the alias resolves to on this route; None on bad config, left for the validation loop to report."""
        try:
            agent = mapping(agents.get(alias), f"agents.{alias}")
            return string(agent.get("provider"), f"agents.{alias}.provider"), model_and_reasoning(agent, alias, route)[0]
        except DispatchError:
            return None

    lpath = ledger_path_from(args)
    ledger = load_ledger(lpath, strict=False)
    reconciled = reconcile_outcomes(ledger, call, now)
    explicit = []
    if args.fallback_from is not None and not args.dry_run:
        for skipped_alias in full_chain[:full_chain.index(args.fallback_from)]:
            target = route_target(skipped_alias)
            if target is not None:
                explicit.append((*target, "fallback-from"))
    for target_provider, target_model, reason in explicit:
        set_explicit_cooldown(ledger, target_provider, target_model, reason, now)
    health = health_cooldowns(ledger, now)

    def cooldown_for(alias):
        # When the caller names this alias to continue from, cooldown does not skip it.
        if args.fallback_from == alias:
            return None
        target = route_target(alias)
        return health.get(health_key(*target)) if target is not None else None

    providers = call("provider", "list", "--environment", validation_environment)
    # Same-tier fallback: each candidate resolves its own routes for this route key; the first to pass validation is
    # dispatched. Cooling candidates are skipped first; if all are cooling, try them anyway so a single-candidate chain
    # never deadlocks.
    all_cooled = all(cooldown_for(alias) for alias in chain)
    attempts = []
    diverted = []
    quota_diverted = []
    catalogs = {}
    choice = None
    for index, alias in enumerate(chain):
        try:
            cd = None if all_cooled else cooldown_for(alias)
            if cd:
                diverted.append(alias)
                if cd.get("quota"):
                    quota_diverted.append(alias)
                rem = int(cd["until"]) - now
                raise DispatchError(f"candidate {alias} is in circuit-breaker cooldown (reason: {cd.get('reason')}, {rem}s remaining).")
            agent = mapping(agents.get(alias), f"agents.{alias}")
            provider = string(agent.get("provider"), f"agents.{alias}.provider")
            model, reasoning = model_and_reasoning(agent, alias, route)
            reasoning = args.reasoning if args.reasoning is not None else reasoning
            if reasoning is not None:
                reasoning = string(reasoning, "reasoning")
            if limited(provider, model):
                used = slots.usage(provider, scopes[provider])
                if used >= limits[provider]:
                    raise DispatchError(f"candidate {alias} is at concurrency capacity ({provider}: {used}/{limits[provider]}); skipped.", code="capacity_full")
            selected = unique(providers, "id", provider, "provider")
            if selected.get("available") is not True:
                raise DispatchError(f"provider {provider} is unavailable in the validation environment.")
            modes = selected.get("capabilities", {}).get("permissionModes", [])
            codex = selected.get("pluginId") == "provider-codex" or provider == "codex" or provider.startswith("codex-")
            default_permission = "auto" if codex and "auto" in modes else "accept-edits"
            permission = args.permission_mode or agent.get("permission_mode", override.get("permission_mode", config.get("permission_mode", default_permission)))
            if permission not in ("accept-edits", "auto", "full"):
                raise DispatchError("permission_mode must be accept-edits, auto or full.")
            if permission not in modes:
                raise DispatchError(f"{provider} does not support permission {permission}; pick a compatible tool, or pass the permission explicitly once the task is authorized.")
            catalog_key = (provider, model)
            if catalog_key not in catalogs:
                catalogs[catalog_key] = call(
                    "provider", "models", provider,
                    "--environment", validation_environment,
                    "--selected-model", model,
                )
            selected_model = unique(catalogs[catalog_key], "id", model, "model")
            levels = [entry.get("reasoningEffort") for entry in (selected_model.get("supportedReasoningEfforts") or [])]
            if reasoning is not None and reasoning not in levels:
                raise DispatchError(f"model {model} does not support reasoning={reasoning}; available: {levels}.")
            agent_fast = agent.get("fast")
            if agent_fast is not None:
                if not isinstance(agent_fast, bool):
                    raise DispatchError(f"agents.{alias}.fast must be true or false.")
                candidate_fast = agent_fast
            else:
                candidate_fast = fast
            if candidate_fast and supports_service_tier(selected, selected_model, "fast"):
                service_tier = "fast"
            elif supports_service_tier(selected, selected_model, "default"):
                service_tier = "default"
            else:
                service_tier = None
        except DispatchError as exc:
            attempts.append({"agent": alias, "error": str(exc)})
            continue
        choice = (index, alias, provider, model, reasoning, service_tier)
        break
    if choice is None:
        detail = "; ".join(f"{item['agent']}: {item['error']}" for item in attempts)
        raise DispatchError(f"no candidate in defaults.{route} chain {chain} is usable: {detail}")
    index, alias, provider, model, reasoning, service_tier = choice
    fallbacks = chain[index + 1:]
    agent_cfg = agents.get(alias) if isinstance(agents.get(alias), dict) else {}
    shape = agent_cfg.get("shape") or AGENT_SHAPES.get(alias) or AGENT_SHAPES.get(provider) or "circle"
    title = thread_title(args.title, args.task, args.difficulty, shape=shape)
    # Parent and child need not share a project: BB's --parent-thread allows a parent in another project, and
    # completion notices still reach it.
    parent = context.get("thread") or {}
    if not parent and os.environ.get("BB_THREAD_ID"):
        parent = (call("thread", "show", os.environ["BB_THREAD_ID"]).get("thread") or {})
    # Any linked parent gets the report protocol, cross-project too; the notification mode decides which variant.
    notifications = args.parent_notifications or config.get("parent_notifications") or "auto"
    if notifications not in PARENT_NOTIFICATION_MODES:
        raise DispatchError(f"parent_notifications must be one of {'/'.join(PARENT_NOTIFICATION_MODES)}, got {notifications!r}")
    protocol = REPORT_PROTOCOL if notifications == "auto" else QUIET_REPORT_PROTOCOL
    task = args.task + REPORT_PROTOCOL_ANCHOR + protocol if parent.get("id") else args.task
    command = ["thread", "spawn", "--project", project, "--environment", environment,
               "--provider", provider, "--model", model,
               "--permission-mode", permission, "--prompt", task]
    if reasoning is not None:
        command += ["--reasoning-level", reasoning]
    if service_tier is not None:
        command += ["--service-tier", service_tier]
    command += ["--title", title]
    if parent.get("id"):
        command += ["--parent-thread", parent["id"]]
        if notifications != "auto":
            command += ["--parent-notifications", notifications]
    plan = dict(project=project, environment=environment, validation_environment=validation_environment,
                agent=alias, provider=provider,
                model=model, reasoning=reasoning, permission_mode=permission,
                service_tier=service_tier,
                purpose=args.purpose, difficulty=args.difficulty, requested_difficulty=args.requested_difficulty, title=title,
                routing_mode=routing_mode, candidate_weights=candidate_weights,
                candidates=chain, fallbacks=fallbacks, attempts=attempts,
                parent_notifications=notifications if parent.get("id") else None)
    if floor_warnings:
        plan["warnings"] = floor_warnings
    if overlay:
        plan["overlay"] = {k: overlay[k] for k in ("path", "note", "expires_at", "overrides", "expired")}
        if overlay_active:
            plan.setdefault("warnings", []).append(
                f"temporary routing overlay active until {overlay['expires_at']} ({', '.join(overlay['overrides'])}); "
                f"main config unchanged. Clear it with --overlay-clear.")
        else:
            plan.setdefault("warnings", []).append(
                f"temporary routing overlay expired at {overlay['expires_at']}; routing by the main config. "
                f"Remove it with --overlay-clear or renew it only if the user asks.")
    if escalate_from:
        plan["escalated_from"] = escalate_from
    if unknown:
        plan["unknown"] = unknown
    if reconciled:
        plan["reconciled"] = reconciled
    if limited(provider, model):
        plan["concurrency"] = {"provider": provider, "limit": limits[provider],
                               "used": slots.usage(provider, scopes[provider])}
        if scopes[provider] is not None:
            plan["concurrency"]["models"] = sorted(scopes[provider])
    if args.dry_run:
        return {"dry_run": True, "selection": plan, "argv": ["bb", *command, "--json"]}

    def persist(extra_cooldowns=(), entry=None):
        """Merge this run's outcomes, cooldowns and new entry into the latest ledger and record review events; write failures only warn."""
        def apply(fresh):
            events = []
            entries = {item.get("id"): item for item in fresh.get("entries", []) if isinstance(item, dict)}
            for update in reconciled:
                target = entries.get(update["id"])
                # An outcome written back concurrently elsewhere wins.
                if target is not None and awaiting_outcome(target):
                    target.update(outcome=update["outcome"], outcome_ts=update["outcome_ts"])
                    # This fault recovered: reset retries so the next error counts from scratch.
                    retries = int(target.pop("retries", 0) or 0)
                    target.pop("retry_ts", None)
                    if retries:
                        events.append(recovered_event(target, retries, now))
            for target_provider, target_model, reason in (*explicit, *extra_cooldowns):
                set_explicit_cooldown(fresh, target_provider, target_model, reason, now)
                events.append({"ts": now, "event": "cooled", "provider": target_provider,
                               "model": target_model, "reason": reason})
            forget_cleared_cooldowns(fresh)
            table = fresh.setdefault("cooldowns", {})
            for key in [k for k, cd in table.items() if not isinstance(cd, dict) or int(cd.get("until") or 0) <= now]:
                del table[key]
            if entry is not None:
                append_ledger_entry(fresh, entry, now=now)
                # The review log outlives the live window and must link dispatch chains and grading reasons, so it carries the same minimal facts.
                extra = {k: entry[k] for k in ("purpose", "parent_thread", "reasoning", "task_chars", "unknown", "escalated_from", "overlay", "advisor")
                         if entry.get(k) is not None}
                if entry.get("requested_difficulty") != entry["difficulty"]:
                    extra["requested_difficulty"] = entry.get("requested_difficulty")
                events.append({"ts": now, "event": "dispatch", "thread": entry["id"], "difficulty": entry["difficulty"],
                               "agent": entry["agent"], "provider": entry["provider"], "model": entry["model"],
                               **extra, **({"diverted": diverted} if diverted else {}),
                               **({"quota_diverted": len(quota_diverted)} if quota_diverted else {})})
            return events
        try:
            return update_ledger(lpath, apply, strict=False)
        except Exception as exc:
            print(f"warning: ledger write failed (ignored, continuing): {exc}", file=sys.stderr)
            return None

    # With a model scope, out-of-scope dispatches are recorded too so later queries do not count them as unknown models.
    reservation = slots.reserve(provider, model) if provider in limits else None
    try:
        result = call(*command)
    except DispatchError as exc:
        persist(extra_cooldowns=[(provider, model, "spawn-failed")])
        if reservation is not None:
            raise DispatchError(f"{exc} Concurrency reservation {reservation['id']} kept; query threads to confirm the creation "
                                "result, then release it with --release-reservation <reservation-ID>; do not retry creation directly.") from exc
        if fallbacks:
            raise DispatchError(
                f"{exc} This candidate is now cooling; after confirming no thread was created, rerunning the same command "
                f"switches to {fallbacks[0]} (or use --fallback-from {fallbacks[0]})."
            ) from exc
        raise
    thread_obj = result.get("thread") if isinstance(result, dict) and isinstance(result.get("thread"), dict) else result
    created_id = (thread_obj or {}).get("id") if isinstance(thread_obj, dict) else None
    if reservation is not None:
        if not created_id:
            raise DispatchError(f"creation response lacks a thread ID; concurrency reservation {reservation['id']} kept. Query threads first.")
        reservation["thread"] = str(created_id)
        slots.save()
    entry = None
    if created_id:
        entry = {
            "id": str(created_id),
            "ts": now,
            "project": project,
            "parent_thread": parent.get("id"),
            "purpose": args.purpose,
            "difficulty": args.difficulty,
            "requested_difficulty": args.requested_difficulty,
            "agent": alias,
            "provider": provider,
            "model": model,
            "reasoning": reasoning,
            "task_chars": effective_task_chars(args.task),
            "outcome": "spawned",
        }
        if unknown:
            entry["unknown"] = unknown[:UNKNOWN_MAX_CHARS]
        if escalate_from:
            entry["escalated_from"] = escalate_from
        if overlay_active:
            entry["overlay"] = True
        if advisor is not None:
            entry["advisor"] = advisor
    merged = persist(entry=entry)
    if entry is not None and merged is not None:
        summary = summarize_ledger(merged, now=now)
        hooks = summary["review_hooks"]
        if hooks:
            plan.setdefault("warnings", []).extend(h["message"] for h in hooks)
    # Return the full creation receipt including queue state; successful creation is not task completion.
    return {"dry_run": False, "selection": plan, "result": result}


def parser():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Examples:\n  bb-dispatch --difficulty simple --task 'Expand the README' --dry-run\n  bb-dispatch --difficulty simple --task 'Login failure is reproducible; find the root cause in the auth path and fix it'\n  bb-dispatch --difficulty medium --task 'Change the tenant isolation boundary; passing tests do not prove there is no leak'\n  bb-dispatch --history-summary\n  bb-dispatch --on-failure thr_xxx\n  bb-dispatch --followups --days 3\nOutput: JSON on stdout, errors on stderr; exit code 0 on success, 2 on failure.")
    p.add_argument("--config", default=os.environ.get("BB_DISPATCH_CONFIG", str(Path.home() / ".config/bb-dispatch/config.yaml")), help="user YAML config path; can also be set via BB_DISPATCH_CONFIG")
    p.add_argument("--ledger", default=os.environ.get("BB_DISPATCH_LEDGER_PATH", str(Path.home() / ".cache/bb-dispatch/ledger.json")), help="run ledger and circuit-breaker cache path; can also be set via BB_DISPATCH_LEDGER_PATH")
    p.add_argument("--difficulty", choices=["simple", "medium", "complex"], help="task difficulty; grading criteria in SKILL.md \"Judgment and invocation\"")
    p.add_argument("--purpose", choices=PURPOSES, default="work",
                   help="dispatch purpose, default work; review skips the project minimum difficulty and routes by the requested difficulty; "
                        "advise routes by defaults.advisor instead of a difficulty, for consulting and proposing plans")
    p.add_argument("--advisor", metavar="ALIAS", help="with --purpose advise: use this advisor from defaults.advisor instead of the configured selection; never falls back to another advisor")
    p.add_argument("--task", help="task goal, scope and acceptance requirements")
    p.add_argument("--escalate-from", metavar="THREAD_ID", help="ID of an earlier thread where the same task failed or needed rework; recorded in the ledger")
    p.add_argument("--unknown", metavar="REASON", help="optional one-sentence grading reason; truncated and recorded in the ledger")
    p.add_argument("--fallback-from", metavar="ALIAS", help="continue from this alias in the defaults.<route> chain; candidates before it are cooled for 15 minutes per provider and model")
    p.add_argument("--reasoning", help="override the reasoning level; still validated against the model catalog")
    p.add_argument("--project", help="project ID; defaults to the environment's project in ID mode and the current project in path mode")
    p.add_argument("--environment", help="existing environment ID or local workspace directory; defaults to the current BB environment")
    p.add_argument("--permission-mode", choices=["accept-edits", "auto", "full"], help="permission override; defaults to the user config, else auto for Codex providers that support it and accept-edits otherwise")
    p.add_argument("--title", help="optional title text; a colored shape prefix (circle/square/heart/book) is added by difficulty and account; taken from the task text when omitted")
    p.add_argument("--parent-notifications", choices=PARENT_NOTIFICATION_MODES,
                   help="which child turn results wake the parent: auto every turn; stuck only on failure, when stuck or awaiting "
                        "approval, with everything else told explicitly by the child; off never wakes it automatically. "
                        "Defaults to the top-level parent_notifications config, else auto")
    p.add_argument("--dry-run", action="store_true", help="validate read-only and print the launch arguments without creating a thread; with --on-failure only report the action, scheduling no retry and writing no ledger")
    modes = p.add_mutually_exclusive_group()
    modes.add_argument("--redispatch", metavar="THREAD_ID", help="redispatch a cooled failed thread with its original difficulty and first-turn task text; records --escalate-from automatically")
    modes.add_argument("--concurrency-status", action="store_true", help="read-only view of current provider usage and pending concurrency reservations; independent of the statistics ledger")
    modes.add_argument("--release-reservation", metavar="RESERVATION_ID", help="remove the given reservation after confirming the creation result; active threads still count by live BB status")
    modes.add_argument("--on-failure", metavar="THREAD_ID", help="call after a child thread errors: retry in the original session after 1, 2 and 4 minutes, and only when exhausted record failure and cool that provider and model")
    modes.add_argument("--history-summary", "--stats", dest="history_summary", action="store_true", help="read-only aggregate statistics from the run ledger, active cooldowns, deterministic review hooks, and a 7-day retry and cooldown summary from the review log")
    modes.add_argument("--followups", action="store_true", help="read-only list of messages the parent or user added after the first delivery of threads dispatched in the last --days days, for rework review")
    p.add_argument("--days", type=int, default=3, help="days to look back with --followups (default 3)")
    modes.add_argument("--record-outcome", "--record-decision", dest="record_outcome", metavar="THREAD_ID", help="correct a run outcome by stable thread ID (overwrites, never appends)")
    modes.add_argument("--overlay-set", metavar="FILE", help="only when the user asks for a temporary route: install a defaults/agents overlay (YAML file, or - for stdin) "
                       "for the current BB thread (or --overlay-thread) on top of the main config, which stays untouched; replaces that thread's previous overlay")
    modes.add_argument("--overlay-show", action="store_true", help="read-only list of temporary routing overlays and whether each is active")
    modes.add_argument("--overlay-clear", metavar="THREAD_ID", nargs="?", const="-", help="remove the overlay of the given thread, default the current BB thread")
    p.add_argument("--overlay-thread", metavar="THREAD_ID", help="thread whose dispatches --overlay-set applies to; defaults to the current BB thread")
    p.add_argument("--hours", type=float, default=OVERLAY_DEFAULT_HOURS, help=f"lifetime of --overlay-set in hours (default {OVERLAY_DEFAULT_HOURS})")
    p.add_argument("--note", help="with --overlay-set: the user's request in a short phrase, kept in the overlay for later review")
    p.add_argument("--outcome", choices=list(OUTCOME_KEYS), help="outcome for --record-outcome; completed is recorded automatically from thread status, failed by --on-failure after retries are exhausted, and can also be set manually for abandoned tasks; every failed* value counts as a consecutive failure")
    return p


def main():
    args = parser().parse_args()
    try:
        if args.concurrency_status or args.release_reservation:
            print(json.dumps(concurrency_command(args), ensure_ascii=False, indent=2))
            return 0
        if args.overlay_set is not None:
            print(json.dumps(overlay_set_command(args), ensure_ascii=False, indent=2))
            return 0
        if args.overlay_show:
            print(json.dumps(overlay_show_command(), ensure_ascii=False, indent=2))
            return 0
        if args.overlay_clear is not None:
            print(json.dumps(overlay_clear_command(args), ensure_ascii=False, indent=2))
            return 0
        if args.history_summary:
            lpath, now = ledger_path_from(args), int(time.time())
            ledger = load_ledger(lpath, strict=False)
            # Fill in outcomes only in memory so statistics stay read-only.
            reconcile_outcomes(ledger, bb, now)
            summary = summarize_ledger(ledger, now)
            summary["retry_review"] = summarize_events(lpath, now)
            print(json.dumps(summary, ensure_ascii=False, indent=2))
            return 0
        if args.on_failure is not None:
            print(json.dumps(on_failure_command(args), ensure_ascii=False, indent=2))
            return 0
        if args.followups:
            print(json.dumps(followups_command(args), ensure_ascii=False, indent=2))
            return 0
        if args.record_outcome is not None:
            print(json.dumps(record_outcome_command(args), ensure_ascii=False, indent=2))
            return 0
        normalize_purpose(args)
        if args.redispatch is None:
            if not args.difficulty or args.task is None:
                raise DispatchError("dispatch mode requires --difficulty (or --purpose advise) and --task.")
            string(args.task, "task")
        result = dispatch(args)
        print(json.dumps(result, ensure_ascii=False, indent=2))
        # Callers often take only the thread ID from stdout, so review reminders also go to stderr where filtering keeps them visible.
        for warning in (result.get("selection") or {}).get("warnings") or []:
            print(f"warning: {warning}", file=sys.stderr)
    except DispatchError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
