#!/usr/bin/env python3
"""按用户配置校验 BB 路由并创建一个线程；不拆任务、不重试创建、不预先修改环境。

defaults.<路由> 可为有序 fallback 链，也可配置 load-balance 候选。脚本只在
spawn 前校验候选（provider 可用性、权限、模型目录与熔断冷却），首个通过者派发；
spawn 发出后任何失败都中止并冷却该候选，由调用方确认线程未创建后重跑。
熔断冷却不读报错文字，分两层退避：子线程报错时由 --on-failure 在原会话按退避重试，
偶发错误在这一层消化；重试用尽才记为失败，按 provider 与模型的连续失败退避派发。
每次派发先按 BB 线程状态把账本里已做完的线程记为 completed，成功一次清零。
关联父线程时在任务末尾附加固定的回报方式，让子线程把回报留到回合结束。

参数见 --help。stdout 为 JSON；stderr 为错误与复盘提醒；退出码 0 成功、2 失败。
依赖 Python 3.10+、PyYAML 和 PATH 上的 bb。
"""
import argparse
import contextlib
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time
import uuid

import yaml

try:
    import fcntl
except ImportError:  # Windows 没有 fcntl，账本退回无锁写入。
    fcntl = None


class DispatchError(Exception):
    def __init__(self, message, code=None):
        super().__init__(message)
        # BB --json 失败时 stdout 错误信封里的 error.code，例如 retry_already_queued；其他错误为 None。
        self.code = code


ROUTE_KEYS = frozenset(("simple", "medium", "complex", "default"))
DIFFICULTIES = ("simple", "medium", "complex")
TITLE_PREFIXES = {"simple": "🟢", "medium": "🟡", "complex": "🔴"}
SHAPED_TITLE_PREFIXES = {
    "circle": {"simple": "🟢", "medium": "🟡", "complex": "🔴"},
    "square": {"simple": "🟩", "medium": "🟨", "complex": "🟥"},
    "heart": {"simple": "💚", "medium": "💛", "complex": "❤️"},
}
AGENT_SHAPES = {
    "codex": "circle",
    "codexl": "square",
    "codex-l": "square",
    "codexb": "heart",
    "codex-b": "heart",
}
ALL_TITLE_PREFIXES = tuple(
    dict.fromkeys(
        ["[Agent]"]
        + list(TITLE_PREFIXES.values())
        + [char for s in SHAPED_TITLE_PREFIXES.values() for char in s.values()]
    )
)
OUTCOME_KEYS = ("spawned", "completed", "failed", "failed_quota", "failed_transient", "failed_other")
# failed 由线程状态自动识别；其余 failed_* 是旧版手动回写的取值，冷却时一视同仁。
FAILED_OUTCOMES = ("failed", "failed_quota", "failed_transient", "failed_other")
DECISION_KEYS = ("accepted", "rejected", "reworked", "escalated")
BACKOFF_BASE_SECONDS = 15 * 60
BACKOFF_MAX_SECONDS = 6 * 3600
SPAWN_COOLDOWN_SECONDS = 15 * 60
# 原会话重试：1、2、4 分钟各一次，用尽才计入派发冷却。
SESSION_RETRY_LIMIT = 3
SESSION_RETRY_BASE_SECONDS = 60
# BB 自动重试给出这两种结论时，原会话再试也是白等：已重试到上限，或额度重置超过它的最长等待。
BB_RETRY_GAVE_UP = ("attempts-exhausted", "beyond-maximum-wait")
# 识别终态、计算冷却和保留账本条目共用的近期窗口。
RECENT_WINDOW_SECONDS = 48 * 3600
LEDGER_LOCK_WAIT_SECONDS = 5
MAX_LIVE_ENTRIES = 200
# 复盘日志超过上限时丢掉较早的一半；汇总只看近 7 天，正常用量下仍留得下几十天。
EVENTS_MAX_BYTES = 4 * 1024 * 1024
DEFAULT_MAX_TASK_CHARS = 2500
UNKNOWN_MAX_CHARS = 120
# 按父线程最近几次派发看分档是否漂向 complex；全局占比会被其他会话稀释。
PARENT_WINDOW = 10
COMPLEX_SHARE_MIN_ENTRIES = 5
COMPLEX_SHARE_MIN_COUNT = 3
COMPLEX_SHARE_THRESHOLD = 0.30
REVIEW_PROMPT_ANCHOR = "# Review agent 提示词"
DRIVER_PAYLOAD_ANCHORS = (
    "\n执行包：\n",
    "\n完成工作后必须提交结构化报告。",
    "\n完成裁决后必须提交结构化报告。",
)
# 关联父线程时附加：子线程的每条中途消息都会唤醒或打断父线程，回报统一留到回合结束。
REPORT_PROTOCOL_ANCHOR = "\n\n## 回报方式（bb-dispatch 附加）\n"
REPORT_PROTOCOL = (
    "回合结束时，BB 会自动把你的最终回复送达父线程；中途用 `bb thread tell` 给它发消息，每条都会唤醒或打断它。"
    "进度、阶段发现、新建资源和对父线程追加消息的回应，都留到回合结束按任务要求一次交代；"
    "需要即时留底的事实（如资源 ID）先写进工作区文件。任务正文另有约定时以正文为准。"
)


def bb(*args):
    creating = args[:2] == ("thread", "spawn")
    try:
        result = subprocess.run(["bb", *args, "--json"], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as exc:
        suffix = " 创建结果未知，请先查询线程，勿直接重试。" if creating else ""
        raise DispatchError(f"BB 调用失败：{exc}.{suffix}") from exc
    if result.returncode:
        suffix = " 请先查询线程确认是否已创建，勿直接重试。" if creating else ""
        try:
            error = json.loads(result.stdout).get("error")
        except (ValueError, AttributeError):
            error = None
        error = error if isinstance(error, dict) else {}
        code = error.get("code")
        detail = "：".join(str(part) for part in (code, error.get("message")) if part) or result.stderr.strip()
        raise DispatchError(f"bb {' '.join(args[:2])} 失败：{detail[:1000]}{suffix}", code=code)
    try:
        return json.loads(result.stdout)
    except ValueError as exc:
        raise DispatchError("BB 返回非 JSON。" + ("创建结果未知，勿直接重试。" if creating else "")) from exc


def mapping(value, where):
    if not isinstance(value, dict):
        raise DispatchError(f"{where} 必须是映射。")
    return value


def string(value, where):
    if not isinstance(value, str) or not value.strip():
        raise DispatchError(f"{where} 必须是非空字符串。")
    return value


def unique(items, key, value, label):
    if not isinstance(items, list):
        raise DispatchError(f"{label} 目录格式未知。")
    matches = [item for item in items if isinstance(item, dict) and item.get(key) == value]
    if len(matches) != 1:
        raise DispatchError(f"{label} {value!r} 缺失或不唯一；请检查用户配置。")
    return matches[0]


def configured_bool(override, config, key, default, where):
    if key in override:
        source, label = override, f"environment {where}"
    elif key in config:
        source, label = config, where
    else:
        return default
    value = source[key]
    if not isinstance(value, bool):
        raise DispatchError(f"{label} 必须是 true 或 false。")
    return value


def tier_ids(entries):
    if not isinstance(entries, list):
        return None
    return [item.get("id") for item in entries if isinstance(item, dict) and item.get("id")]


def supports_service_tier(provider, model, tier):
    provider_ids = tier_ids(provider.get("serviceTiers"))
    if provider_ids is None or tier not in provider_ids:
        return False
    if tier == "default":
        return True
    model_ids = tier_ids(model.get("supportedServiceTiers"))
    return True if model_ids is None else tier in model_ids


def thread_title(title, task, difficulty, shape="circle"):
    text = " ".join((title or "").split()) or " ".join(task.split())
    while True:
        prefix = next((p for p in ALL_TITLE_PREFIXES if text == p or text.startswith(p + " ")), None)
        if prefix is None:
            break
        text = text[len(prefix):].strip()
    text = text or "任务"
    if len(text) > 80:
        text = text[:79] + "…"
    prefix_map = SHAPED_TITLE_PREFIXES.get(shape, TITLE_PREFIXES)
    prefix_char = prefix_map.get(difficulty, "⚪")
    return prefix_char + " " + text


def effective_task_chars(task):
    body = task.split(REVIEW_PROMPT_ANCHOR, 1)[0] if REVIEW_PROMPT_ANCHOR in task else task
    for anchor in DRIVER_PAYLOAD_ANCHORS:
        if anchor in body:
            body = body.split(anchor, 1)[0]
    if "\nWorker 报告：" in body and "\n需要证据时读取对应 BB 线程" in body:
        before, rest = body.split("\nWorker 报告：", 1)
        _, after = rest.split("\n需要证据时读取对应 BB 线程", 1)
        body = before + "\n需要证据时读取对应 BB 线程" + after
    if "# Verified context" in body and "# Question for the oracle" in body:
        before, rest = body.split("# Verified context", 1)
        if "# Question for the oracle" in rest:
            _, after = rest.split("# Question for the oracle", 1)
            body = before + "# Question for the oracle" + after
    return len(body.strip())


def ledger_path_from(args):
    raw = getattr(args, "ledger", None) or os.environ.get(
        "BB_DISPATCH_LEDGER_PATH", str(Path.home() / ".cache/bb-dispatch/ledger.json")
    )
    return Path(raw).expanduser()


def empty_ledger():
    return {"version": 1, "entries": [], "rollups": {}, "cooldowns": {}}


def load_ledger(path, strict=False):
    if not path.exists():
        return empty_ledger()
    try:
        data = json.loads(path.read_text())
        if not isinstance(data, dict) or data.get("version") != 1:
            raise ValueError("账本版本或格式无效")
        if not isinstance(data.get("entries"), list) or not isinstance(data.get("rollups"), dict) or not isinstance(data.get("cooldowns"), dict):
            raise ValueError("账本字段缺失或类型错误")
        return data
    except Exception as exc:
        if strict:
            raise DispatchError(f"无法读取运行账本 {path}：{exc}") from exc
        print(f"warning: 账本读取失败（已旁路忽略）：{exc}", file=sys.stderr)
        return empty_ledger()


def save_ledger(path, data, strict=False):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2))
        tmp.replace(path)
    except Exception as exc:
        if strict:
            raise DispatchError(f"无法写入运行账本 {path}：{exc}") from exc
        print(f"warning: 账本写入失败（已旁路忽略）：{exc}", file=sys.stderr)


@contextlib.contextmanager
def ledger_lock(path):
    """跨进程串行化账本读改写；等不到锁只告警，不挡派发。"""
    handle = None
    if fcntl is not None:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            handle = open(path.with_name(path.name + ".lock"), "a")
            deadline = time.monotonic() + LEDGER_LOCK_WAIT_SECONDS
            while True:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise TimeoutError(f"等待超过 {LEDGER_LOCK_WAIT_SECONDS}s")
                    time.sleep(0.05)
        except Exception as exc:
            print(f"warning: 账本加锁失败（已旁路继续）：{exc}", file=sys.stderr)
            if handle is not None:
                handle.close()
                handle = None
    try:
        yield
    finally:
        if handle is not None:
            handle.close()


def events_path(ledger_path):
    """复盘日志与账本同目录，只追加：ledger.json 对应 ledger.events.jsonl。"""
    return ledger_path.with_name(ledger_path.stem + ".events.jsonl")


def append_events(ledger_path, events):
    """每行一个 JSON 事件；调用方持有账本锁，写入失败只告警，不挡派发。"""
    if not events:
        return
    try:
        target = events_path(ledger_path)
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open("a") as handle:
            handle.writelines(json.dumps(event, ensure_ascii=False) + "\n" for event in events)
        if target.stat().st_size > EVENTS_MAX_BYTES:
            lines = target.read_text().splitlines(keepends=True)
            tmp = target.with_suffix(target.suffix + ".tmp")
            tmp.write_text("".join(lines[len(lines) // 2:]))
            tmp.replace(target)
    except Exception as exc:
        print(f"warning: 复盘日志写入失败（已旁路忽略）：{exc}", file=sys.stderr)


def update_ledger(path, mutate, strict=False):
    """加锁后重读账本再改写，并发的派发与回写互不覆盖；mutate 返回的复盘事件随后追加进日志。"""
    with ledger_lock(path):
        ledger = load_ledger(path, strict=strict)
        events = mutate(ledger)
        save_ledger(path, ledger, strict=strict)
        append_events(path, events)
    return ledger


def rollup_entry(rollups, entry):
    key = f"{entry.get('difficulty')}|{entry.get('agent')}|{entry.get('provider')}|{entry.get('model')}"
    bucket = rollups.get(key)
    if not isinstance(bucket, dict):
        bucket = {
            "difficulty": entry.get("difficulty"),
            "agent": entry.get("agent"),
            "provider": entry.get("provider"),
            "model": entry.get("model"),
            "total": 0,
            "outcomes": {k: 0 for k in OUTCOME_KEYS},
            "decisions": {k: 0 for k in DECISION_KEYS},
        }
        rollups[key] = bucket
    bucket["total"] = int(bucket.get("total", 0)) + 1
    outcome = entry.get("outcome") or "spawned"
    if outcome in OUTCOME_KEYS:
        bucket["outcomes"][outcome] = int(bucket["outcomes"].get(outcome, 0)) + 1
    decision = entry.get("decision")
    if decision in bucket["decisions"]:
        bucket["decisions"][decision] = int(bucket["decisions"].get(decision, 0)) + 1


def outcome_time(entry):
    """条目的终态时间；旧版条目没有 outcome_ts，取派发时间。"""
    return int(entry.get("outcome_ts") or entry.get("ts") or 0)


def append_ledger_entry(ledger, entry, max_live=MAX_LIVE_ENTRIES, now=None):
    entries = ledger.setdefault("entries", [])
    rollups = ledger.setdefault("rollups", {})
    # 同一稳定 ID 若已存在则原地覆盖，避免重复计数。
    for idx, existing in enumerate(entries):
        if isinstance(existing, dict) and existing.get("id") == entry["id"]:
            entries[idx] = entry
            return
    entries.append(entry)
    excess = len(entries) - max_live
    if excess <= 0:
        return
    # 近期窗口内的条目还要识别终态、参与冷却计算，超出上限也先留着，只折算更早的条目。
    horizon = int(time.time() if now is None else now) - RECENT_WINDOW_SECONDS
    kept = []
    for item in entries:
        if excess > 0 and (not isinstance(item, dict) or outcome_time(item) < horizon):
            if isinstance(item, dict):
                rollup_entry(rollups, item)
            excess -= 1
        else:
            kept.append(item)
    entries[:] = kept


def health_key(provider, model):
    return f"{provider}|{model}"


def backoff_seconds(level):
    return min(BACKOFF_MAX_SECONDS, BACKOFF_BASE_SECONDS * 2 ** (level - 1))


def set_explicit_cooldown(ledger, provider, model, reason, now):
    """spawn 失败或被 --fallback-from 跳过的候选没有线程状态可读，单独冷却固定时长。"""
    table = ledger.setdefault("cooldowns", {})
    key = health_key(provider, model)
    current = table.get(key)
    # 并发时别处可能已记下结束更晚的冷却，不缩短它。
    if isinstance(current, dict) and int(current.get("until") or 0) >= now + SPAWN_COOLDOWN_SECONDS:
        return
    table[key] = {
        "provider": provider,
        "model": model,
        "reason": reason,
        "since": now,
        "until": now + SPAWN_COOLDOWN_SECONDS,
    }


def health_cooldowns(ledger, now):
    """按 provider 与模型计算当前冷却，不区分失败类型，只看近期窗口内的终态。

    连续失败从 BACKOFF_BASE_SECONDS 起翻倍，封顶 BACKOFF_MAX_SECONDS，成功一次清零。
    冷却期内的失败只把冷却顺延到这次失败之后，冷却结束后再失败才升级。
    """
    horizon = now - RECENT_WINDOW_SECONDS
    events = {}
    for entry in ledger.get("entries") or []:
        if not isinstance(entry, dict) or not entry.get("provider") or not entry.get("model"):
            continue
        outcome = entry.get("outcome")
        if outcome != "completed" and outcome not in FAILED_OUTCOMES:
            continue
        at = outcome_time(entry)
        if at < horizon:
            continue
        key = health_key(entry["provider"], entry["model"])
        events.setdefault(key, []).append((at, str(entry.get("id") or ""), outcome))
    state = {}
    for key, items in events.items():
        level = until = last_success = 0
        thread_id = None
        for at, thread, outcome in sorted(items):
            if outcome == "completed":
                level = until = 0
                last_success = at
                continue
            if at >= until:
                level += 1
            until = max(until, at + backoff_seconds(level))
            thread_id = thread
        state[key] = {"until": until, "level": level, "reason": f"连续失败 {level} 次",
                      "thread_id": thread_id, "last_success": last_success}
    for key, cd in (ledger.get("cooldowns") or {}).items():
        # 旧版按 路由|别名 记的冷却没有 provider 字段，不再生效，到期后随派发清理。
        if not isinstance(cd, dict) or "provider" not in cd:
            continue
        current = state.setdefault(key, {"until": 0, "level": 0, "reason": None, "thread_id": None, "last_success": 0})
        # 冷却记下之后又有成功，说明已恢复。
        if current["last_success"] > int(cd.get("since") or 0):
            continue
        if int(cd.get("until") or 0) > current["until"]:
            current.update(until=int(cd["until"]), reason=cd.get("reason"), thread_id=None)
    cooled = {}
    for key, value in state.items():
        if value["until"] > now:
            provider, model = key.split("|", 1)
            cooled[key] = {"provider": provider, "model": model, "reason": value["reason"],
                           "level": value["level"], "until": value["until"], "thread_id": value["thread_id"]}
    return cooled


def thread_completed(thread):
    """只看 bb thread list 的结构化线程状态：空闲、没有排队消息、没有待处理交互才算做完。"""
    return (thread.get("status") == "idle" and thread.get("queuedWork", "none") == "none"
            and not thread.get("hasPendingInteraction"))


def awaiting_outcome(entry):
    """还在等结果的条目：从未结束，或成功过之后又报错、正在原会话重试。"""
    outcome = entry.get("outcome") or "spawned"
    return outcome == "spawned" or (int(entry.get("retries") or 0) > 0 and outcome not in FAILED_OUTCOMES)


def reconcile_outcomes(ledger, call, now):
    """把账本里近期还在等结果、已经做完的线程改记为 completed。

    报错不在这里记失败：单次报错先由 --on-failure 在原会话重试，重试用尽才记失败。
    只改传入的账本并返回改动；读不到线程状态时告警后返回空列表，不挡派发。
    """
    try:
        pending = {
            entry["id"]: entry for entry in ledger.get("entries") or []
            if isinstance(entry, dict) and entry.get("id") and awaiting_outcome(entry)
            and int(entry.get("ts") or 0) >= now - RECENT_WINDOW_SECONDS
        }
        if not pending:
            return []
        threads = call("thread", "list")
        if not isinstance(threads, list):
            raise DispatchError("bb thread list 返回格式未知")
        updates = []
        for thread in threads:
            entry = pending.get(thread.get("id")) if isinstance(thread, dict) else None
            if entry is None or not thread_completed(thread):
                continue
            # updatedAt 不早于这次结束；归档等操作会再推后它。
            updated = thread.get("updatedAt")
            at = min(now, int(updated) // 1000) if isinstance(updated, (int, float)) else now
            updates.append({"id": entry["id"], "outcome": "completed", "outcome_ts": at})
    except Exception as exc:
        print(f"warning: 读取线程状态失败，本次不补记完成（已旁路继续）：{exc}", file=sys.stderr)
        return []
    for update in updates:
        pending[update["id"]].update(outcome=update["outcome"], outcome_ts=update["outcome_ts"])
    return updates


def record_decision_command(args, now=None):
    if not args.decision and not args.outcome:
        raise DispatchError("--record-decision 必须至少配合 --decision 或 --outcome 之一。")
    target_id = string(args.record_decision, "--record-decision")
    now = int(time.time() if now is None else now)
    recorded = {}

    def apply(ledger):
        matched = next((entry for entry in ledger.get("entries", [])
                        if isinstance(entry, dict) and entry.get("id") == target_id), None)
        if matched is None:
            raise DispatchError(f"账本 live 窗口中未找到线程 {target_id!r}，拒绝回写未知 ID。")
        events = []
        # 终态时间只随终态变化；单独回写裁决不能把失败或成功挪到现在。
        if args.outcome and args.outcome != (matched.get("outcome") or "spawned"):
            matched["outcome"], matched["outcome_ts"] = args.outcome, now
            if args.outcome in FAILED_OUTCOMES:
                events.append(cooled_event(ledger, matched, "manual", now, int(matched.get("retries") or 0)))
        if args.decision:
            matched["decision"] = args.decision
        matched["updated_ts"] = now
        recorded.update(matched)
        return events

    update_ledger(ledger_path_from(args), apply, strict=True)
    return {"recorded": True, "entry": recorded}


def cooled_event(ledger, entry, reason, now, retries):
    """记失败后的复盘事件：这次冷却的等级与结束时间，以及这次故障在原会话重试过几次。"""
    cooldown = health_cooldowns(ledger, now).get(health_key(entry.get("provider"), entry.get("model"))) or {}
    return {"ts": now, "event": "cooled", "thread": entry.get("id"), "provider": entry.get("provider"),
            "model": entry.get("model"), "reason": reason, "retries": retries,
            "level": cooldown.get("level"), "until": cooldown.get("until")}


def recovered_event(entry, retries, now):
    """原会话重试后线程成功过的复盘事件；retries 是这次故障安排过的重试次数。"""
    return {"ts": now, "event": "recovered", "thread": entry.get("id"), "provider": entry.get("provider"),
            "model": entry.get("model"), "retries": retries}


def turns_ended_since(call, thread_id, since):
    """线程日志里 since（秒）之后结束的回合状态，按先后排列。"""
    events = call("thread", "log", thread_id, "--all")
    if not isinstance(events, list):
        raise DispatchError("bb thread log 返回格式未知")
    return [(event.get("data") or {}).get("status") for event in events
            if isinstance(event, dict) and event.get("type") == "turn/completed"
            and int(event.get("createdAt") or 0) >= since * 1000]


def on_failure_command(args, call=bb, now=None):
    """子线程报错后由父线程调用：先在原会话按退避重试，重试用尽才记失败、冷却该 provider 与模型。

    只看 BB 的结构化信息：线程状态、BB 自动重试的结论和线程日志里回合的结束状态，不读报错文字。
    报错线程上的排队消息要等线程被重试才送出，所以排队数不当作"已有重试"。
    """
    target_id = string(args.on_failure, "--on-failure")
    now = int(time.time() if now is None else now)
    lpath = ledger_path_from(args)

    def find(ledger):
        entry = next((item for item in ledger.get("entries", [])
                      if isinstance(item, dict) and item.get("id") == target_id), None)
        if entry is None:
            raise DispatchError(f"账本 live 窗口中未找到线程 {target_id!r}；只处理经 bb-dispatch 派发的线程。")
        return entry

    def optional(*command):
        # BB 自动重试插件不可用时按没有结论处理，不挡原会话重试。
        try:
            value = call(*command)
        except DispatchError:
            return {}
        return value if isinstance(value, dict) else {}

    def waiting(why):
        return {"action": "waiting", "message": f"{why}，结束回合等通知。"}

    ledger = load_ledger(lpath, strict=True)
    entry = find(ledger)
    target = f"{entry.get('provider')}/{entry.get('model')}"
    shown = mapping(call("thread", "show", target_id), "thread")
    thread = shown.get("thread") if isinstance(shown.get("thread"), dict) else shown
    if thread.get("status") != "error":
        return {"action": "not-failed", "status": thread.get("status"), "message": "线程不在报错状态，照常等待通知。"}
    if optional("provider-retry", "status", target_id).get("retries"):
        if not args.dry_run:
            with ledger_lock(lpath):
                append_events(lpath, [{"ts": now, "event": "deferred", "thread": target_id,
                                       "provider": entry.get("provider"), "model": entry.get("model")}])
        return waiting("BB 自动重试已排队")

    def cooled(reason, data):
        result = {"action": "cooled", "reason": reason,
                  "message": f"{reason}，已记为失败并冷却 {target}；用原难度与完整任务文本重跑 bb-dispatch 会换候选。"}
        cooldown = health_cooldowns(data, now).get(health_key(entry.get("provider"), entry.get("model")))
        if cooldown:
            result["cooldown"] = {**cooldown, "remaining_seconds": cooldown["until"] - now}
        return result

    if (entry.get("outcome") or "spawned") in FAILED_OUTCOMES:
        return cooled("该线程已记为失败", ledger)
    retries = int(entry.get("retries") or 0)
    recovered = False
    if retries:
        # 重试最早 1 分钟后才执行，本机与 BB 服务的时钟差不会把安排之前的回合算进来。
        ended = turns_ended_since(call, target_id, int(entry.get("retry_ts") or 0))
        if ended == []:
            return waiting("上次安排的原会话重试还没执行")
        # 上次安排重试之后成功过：那次故障已恢复，这是新的一次故障，从头计。
        recovered = "completed" in ended
    attempt = 1 if recovered else retries + 1
    events = [recovered_event(entry, retries, now)] if recovered else []
    diagnostic = optional("provider-retry", "explain", target_id).get("diagnostic")
    decision = diagnostic.get("decision") if isinstance(diagnostic, dict) else None
    if isinstance(decision, dict) and decision.get("kind") == "decline" and decision.get("reason") in BB_RETRY_GAVE_UP:
        code, reason = "bb-gave-up", "BB 已在原会话重试到上限，或判定额度短期回不来"
    elif attempt > SESSION_RETRY_LIMIT:
        code, reason = "exhausted", f"原会话重试 {SESSION_RETRY_LIMIT} 次仍失败"
    else:
        delay = SESSION_RETRY_BASE_SECONDS * 2 ** (attempt - 1)
        result = {"action": "retry-scheduled", "attempt": attempt, "limit": SESSION_RETRY_LIMIT, "delay_seconds": delay,
                  "message": f"已安排原会话第 {attempt}/{SESSION_RETRY_LIMIT} 次重试，{delay // 60} 分钟后执行；结束回合等通知。"}
        if args.dry_run:
            return {"dry_run": True, **result}
        try:
            call("thread", "retry", target_id, "--send-at", f"{delay}s",
                 "--reason", f"bb-dispatch 原会话重试 {attempt}/{SESSION_RETRY_LIMIT}")
        except DispatchError as exc:
            if exc.code == "retry_already_queued":
                return waiting("这个回合已有排队的重试")
            code, reason = "retry-impossible", f"无法在原会话重试（{exc}）"
        else:
            def mark_retry(data):
                matched = find(data)
                # 终态不动：成功过的线程保留那次成功，冷却照旧按它清零。
                matched["retries"], matched["retry_ts"], matched["updated_ts"] = attempt, now, now
                return [*events, {"ts": now, "event": "retry", "thread": target_id, "provider": matched.get("provider"),
                                  "model": matched.get("model"), "attempt": attempt, "delay": delay}]
            update_ledger(lpath, mark_retry, strict=True)
            return result
    if args.dry_run:
        return {"dry_run": True, "action": "cooled", "reason": reason}

    def mark_failed(data):
        matched = find(data)
        matched["outcome"], matched["outcome_ts"], matched["updated_ts"] = "failed", now, now
        matched["retries"] = attempt - 1
        return [*events, cooled_event(data, matched, code, now, attempt - 1)]
    return cooled(reason, update_ledger(lpath, mark_failed, strict=True))


def summarize_ledger(ledger, now=None):
    now = int(time.time() if now is None else now)
    by_difficulty = {
        d: {"total": 0, "failed": 0, "decided": 0, "accepted": 0}
        for d in DIFFICULTIES
    }
    by_agent = {}

    def ensure_agent(agent):
        if agent not in by_agent:
            by_agent[agent] = {
                "total": 0,
                "outcomes": {k: 0 for k in OUTCOME_KEYS},
                "decisions": {k: 0 for k in DECISION_KEYS},
            }
        return by_agent[agent]

    rolled_up_count = 0
    for bucket in (ledger.get("rollups") or {}).values():
        if not isinstance(bucket, dict):
            continue
        total = int(bucket.get("total", 0))
        rolled_up_count += total
        diff = bucket.get("difficulty")
        agent = bucket.get("agent") or "unknown"
        outcomes = bucket.get("outcomes") or {}
        decisions = bucket.get("decisions") or {}
        failed = sum(int(outcomes.get(k, 0)) for k in FAILED_OUTCOMES)
        decided = sum(int(decisions.get(k, 0)) for k in DECISION_KEYS)
        accepted = int(decisions.get("accepted", 0))
        if diff in by_difficulty:
            by_difficulty[diff]["total"] += total
            by_difficulty[diff]["failed"] += failed
            by_difficulty[diff]["decided"] += decided
            by_difficulty[diff]["accepted"] += accepted
        ag = ensure_agent(agent)
        ag["total"] += total
        for k in OUTCOME_KEYS:
            ag["outcomes"][k] += int(outcomes.get(k, 0))
        for k in DECISION_KEYS:
            ag["decisions"][k] += int(decisions.get(k, 0))

    live_entries = [e for e in (ledger.get("entries") or []) if isinstance(e, dict)]
    for entry in live_entries:
        diff = entry.get("difficulty")
        agent = entry.get("agent") or "unknown"
        outcome = entry.get("outcome") or "spawned"
        decision = entry.get("decision")
        is_failed = 1 if outcome in FAILED_OUTCOMES else 0
        is_decided = 1 if decision in DECISION_KEYS else 0
        is_accepted = 1 if decision == "accepted" else 0
        if diff in by_difficulty:
            by_difficulty[diff]["total"] += 1
            by_difficulty[diff]["failed"] += is_failed
            by_difficulty[diff]["decided"] += is_decided
            by_difficulty[diff]["accepted"] += is_accepted
        ag = ensure_agent(agent)
        ag["total"] += 1
        if outcome in ag["outcomes"]:
            ag["outcomes"][outcome] += 1
        if decision in ag["decisions"]:
            ag["decisions"][decision] += 1

    total_dispatches = rolled_up_count + len(live_entries)
    for diff, stats in by_difficulty.items():
        stats["share"] = round(stats["total"] / total_dispatches, 4) if total_dispatches else 0.0

    hooks = []
    if total_dispatches >= 5 and by_difficulty["simple"]["share"] < 0.20:
        hooks.append({
            "hook": "simple_share_low",
            "numerator": by_difficulty["simple"]["total"],
            "denominator": total_dispatches,
            "message": f"simple 难度占比仅 {by_difficulty['simple']['total']}/{total_dispatches} (<20%)，请核查是否将边界已闭合任务误判为 medium/complex。",
        })

    recent = {}
    for entry in sorted(live_entries, key=lambda e: e.get("ts") or 0, reverse=True):
        parent = entry.get("parent_thread")
        if parent and len(recent.setdefault(parent, [])) < PARENT_WINDOW:
            recent[parent].append(entry.get("difficulty"))
    by_parent = {}
    for parent, diffs in sorted(recent.items()):
        if len(diffs) < COMPLEX_SHARE_MIN_ENTRIES:
            continue
        counts = {d: diffs.count(d) for d in DIFFICULTIES}
        by_parent[parent] = {"recent": len(diffs), **counts}
        if counts["complex"] >= COMPLEX_SHARE_MIN_COUNT and counts["complex"] / len(diffs) >= COMPLEX_SHARE_THRESHOLD:
            hooks.append({
                "hook": "complex_share_high",
                "parent_thread": parent,
                "numerator": counts["complex"],
                "denominator": len(diffs),
                "message": f"父线程 {parent} 最近 {len(diffs)} 次派发里 complex 占 {counts['complex']} 次（>=30%）。"
                           "complex 只留给说不出落在哪个系统、也列不出候选方案的最大未知；其余按剩余未知派 medium 或 simple，"
                           "低档失败或返工再带 --escalate-from 升档。",
            })

    for agent, ag in sorted(by_agent.items()):
        total = ag["total"]
        failed = sum(ag["outcomes"][k] for k in FAILED_OUTCOMES)
        decided = sum(ag["decisions"][k] for k in DECISION_KEYS)
        accepted = ag["decisions"]["accepted"]
        ag["failed"] = failed
        ag["failure_rate"] = round(failed / total, 4) if total else 0.0
        ag["decided"] = decided
        ag["accepted"] = accepted
        ag["acceptance_rate"] = round(accepted / decided, 4) if decided else None
        if total >= 3 and ag["failure_rate"] >= 0.30:
            hooks.append({
                "hook": "high_failure_rate",
                "agent": agent,
                "numerator": failed,
                "denominator": total,
                "message": f"候选 {agent} 失败率 {failed}/{total} (>=30%)，请检查其配额或服务稳定性。",
            })
        if decided >= 3 and ag["acceptance_rate"] is not None and ag["acceptance_rate"] < 0.50:
            hooks.append({
                "hook": "low_acceptance_rate",
                "agent": agent,
                "numerator": accepted,
                "denominator": decided,
                "message": f"候选 {agent} 接受率 {accepted}/{decided} (<50%)，请复盘其绑定模型与路由难度是否匹配。",
            })

    active_cooldowns = [
        {**cd, "remaining_seconds": cd["until"] - now}
        for _, cd in sorted(health_cooldowns(ledger, now).items())
    ]

    return {
        "total_dispatches": total_dispatches,
        "live_entries": len(live_entries),
        "rolled_up_entries": rolled_up_count,
        "by_difficulty": by_difficulty,
        "by_agent": by_agent,
        "by_parent": by_parent,
        "active_cooldowns": active_cooldowns,
        "review_hooks": hooks,
    }


def summarize_events(ledger_path, now, days=7):
    """按复盘日志汇总近几天的派发、原会话重试与冷却：重试是否奏效、冷却是否频繁、走势是否正常。"""
    counters = {"dispatch": "dispatches", "deferred": "deferred_to_bb", "retry": "retries",
                "recovered": "recovered", "cooled": "cooled"}
    totals = dict.fromkeys(("dispatches", "diverted_dispatches", "deferred_to_bb", "retries", "recovered", "cooled",
                            "retried_then_cooled"), 0)
    recovered_by_attempt, cooled_by_reason, by_target, daily = {}, {}, {}, {}
    try:
        lines = events_path(ledger_path).read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        key = counters.get(event.get("event")) if isinstance(event, dict) else None
        if key is None or int(event.get("ts") or 0) < now - days * 86400:
            continue
        day = daily.setdefault(time.strftime("%Y-%m-%d", time.localtime(int(event["ts"]))), dict.fromkeys(totals, 0))
        target = by_target.setdefault(f"{event.get('provider')}|{event.get('model')}",
                                      {**dict.fromkeys(counters.values(), 0), "max_level": 0})
        for bucket in (totals, day, target):
            bucket[key] += 1
        if event.get("diverted"):
            totals["diverted_dispatches"] += 1
            day["diverted_dispatches"] += 1
        if key == "recovered":
            attempt = str(event.get("retries"))
            recovered_by_attempt[attempt] = recovered_by_attempt.get(attempt, 0) + 1
        if key == "cooled":
            reason = str(event.get("reason"))
            cooled_by_reason[reason] = cooled_by_reason.get(reason, 0) + 1
            target["max_level"] = max(target["max_level"], int(event.get("level") or 0))
            if int(event.get("retries") or 0) > 0:
                totals["retried_then_cooled"] += 1
    # 原会话重试过的故障只有两种收场：恢复，或最终冷却。
    ended = totals["recovered"] + totals["retried_then_cooled"]
    return {"window_days": days, **totals,
            "retry_recovery_rate": round(totals["recovered"] / ended, 4) if ended else None,
            "recovered_by_attempt": recovered_by_attempt, "cooled_by_reason": cooled_by_reason,
            "by_target": by_target, "daily": [{"date": date, **counts} for date, counts in sorted(daily.items())]}


def candidate_chain(args, defaults, route):
    value = defaults.get(route)
    if isinstance(value, str):
        chain, mode, weights = [value], "fallback", None
    elif isinstance(value, list) and value:
        chain, mode, weights = value, "fallback", None
    elif isinstance(value, dict):
        unknown = set(value) - {"mode", "candidates"}
        if unknown:
            raise DispatchError(f"defaults.{route} 路由配置存在未知项：{sorted(unknown)}。")
        mode = string(value.get("mode"), f"defaults.{route}.mode")
        if mode not in ("fallback", "load-balance", "weighted-load-balance"):
            raise DispatchError(
                f"defaults.{route}.mode 必须是 fallback、load-balance 或 weighted-load-balance。"
            )
        candidates = value.get("candidates")
        if mode == "weighted-load-balance":
            if not isinstance(candidates, dict) or not candidates:
                raise DispatchError(f"defaults.{route}.candidates 必须是非空的 别名: 权重 映射。")
            chain, weights = [], {}
            for raw_alias, weight in candidates.items():
                alias = string(raw_alias, f"defaults.{route} 候选别名")
                if isinstance(weight, bool) or not isinstance(weight, (int, float)) or not math.isfinite(weight) or weight < 0:
                    raise DispatchError(f"defaults.{route}.candidates.{alias} 权重必须是大于或等于 0 的有限数字。")
                if weight == 0:
                    continue
                chain.append(alias)
                weights[alias] = weight
            if not chain:
                raise DispatchError(f"defaults.{route}.candidates 至少需要一个权重大于 0 的候选。")
        else:
            if not isinstance(candidates, list) or not candidates:
                raise DispatchError(f"defaults.{route}.candidates 必须是非空别名列表。")
            chain, weights = candidates, None
    else:
        raise DispatchError(f"defaults.{route} 必须是非空别名、有序别名列表或路由配置。")
    chain = [string(item, f"defaults.{route} 候选项") for item in chain]
    if len(set(chain)) != len(chain):
        raise DispatchError(f"defaults.{route} 候选别名不能重复。")
    weights = weights or {alias: 1 for alias in chain}
    if mode in ("load-balance", "weighted-load-balance"):
        # Deterministic rendezvous ordering spreads independent tasks without mutable state.
        # Exponential races extend it to weighted selection while preserving a stable fallback order.
        key = f"{route}\0{args.task}".encode()
        if mode == "load-balance":
            chain = sorted(
                chain,
                key=lambda alias: hashlib.sha256(key + b"\0" + alias.encode()).digest(),
                reverse=True,
            )
        else:
            def weighted_score(alias):
                digest = hashlib.sha256(key + b"\0" + alias.encode()).digest()
                uniform = (int.from_bytes(digest) + 1) / (2 ** 256 + 1)
                return -math.log(uniform) / weights[alias]
            chain = sorted(chain, key=weighted_score)
    full_chain = list(chain)
    if args.fallback_from is not None:
        start = string(args.fallback_from, "--fallback-from")
        if start not in chain:
            raise DispatchError(f"--fallback-from {start!r} 不在 defaults.{route} 候选 {chain} 中。")
        chain = chain[chain.index(start):]
    return chain, mode, {alias: weights[alias] for alias in chain}, full_chain


def model_and_reasoning(agent, alias, route):
    if "model" in agent or "reasoning" in agent:
        raise DispatchError(f"agents.{alias} 的 model/reasoning 必须放在 routes.<路由> 下。")
    routes = mapping(agent.get("routes"), f"agents.{alias}.routes")
    unknown = [repr(key) for key in routes if key not in ROUTE_KEYS]
    if unknown:
        raise DispatchError(f"agents.{alias}.routes 只支持 {sorted(ROUTE_KEYS)}；未知项：{', '.join(unknown)}。")
    profile_name = next((key for key in (route, "default") if key in routes), None)
    if profile_name is None:
        raise DispatchError(f"agents.{alias}.routes 缺少 {route!r} 或 'default'；该候选不参与本次路由。")
    profile = mapping(routes[profile_name], f"agents.{alias}.routes.{profile_name}")
    model = string(profile.get("model"), f"agents.{alias}.routes.{profile_name}.model")
    reasoning = profile.get("reasoning")
    if reasoning is not None:
        reasoning = string(reasoning, f"agents.{alias}.routes.{profile_name}.reasoning")
    return model, reasoning


def validate_contract_gates(args, call):
    escalate_from = getattr(args, "escalate_from", None)
    if escalate_from is not None:
        escalate_from = string(escalate_from, "--escalate-from")
        shown = mapping(call("thread", "show", escalate_from), "escalate-from thread")
        shown_thread = shown.get("thread") if isinstance(shown.get("thread"), dict) else shown
        if shown_thread.get("id") and shown_thread.get("id") != escalate_from:
            raise DispatchError(f"--escalate-from 线程 {escalate_from!r} 校验不匹配。")

    if getattr(args, "closed_scope", False) and args.difficulty != "simple" and not escalate_from:
        raise DispatchError(
            f"边界已闭合（--closed-scope）的任务必须使用 --difficulty simple；"
            f"当前传入 {args.difficulty!r}。若因前序低档线程失败需升档，请提供 --escalate-from <前序线程ID>。"
        )

    unknown = (getattr(args, "unknown", None) or "").strip()
    if args.difficulty == "complex" and not escalate_from and not unknown and not getattr(args, "dry_run", False):
        raise DispatchError(
            "首次派 complex 要用 --unknown 写一句最大未知，并确认它没有边界：说不出它落在哪个系统或哪条链路，"
            "也列不出候选方案。能说出其一就是有边界，改派 --difficulty medium；"
            "前序低档线程失败或返工要升档时传 --escalate-from <线程ID>。"
        )

    max_chars = getattr(args, "max_task_chars", DEFAULT_MAX_TASK_CHARS)
    if max_chars is None:
        max_chars = DEFAULT_MAX_TASK_CHARS
    if max_chars > 0 and args.difficulty in ("medium", "complex") and not escalate_from:
        chars = effective_task_chars(args.task)
        if chars > max_chars:
            raise DispatchError(
                f"{args.difficulty} 任务应把探索留给子线程；当前任务指导长达 {chars} 字符（上限 {max_chars}），"
                "说明父线程已完成细化。请改用 --difficulty simple、精简任务书，或传入 --escalate-from <前序失败线程ID>。"
            )
    return escalate_from


# 独立于 --ledger/--config：同一 OS 用户的派发进程共用锁与未决占位。
CONCURRENCY_PATH = Path.home() / ".cache/bb-dispatch/concurrency.json"
CONCURRENCY_LOCK_WAIT_SECONDS = 10


@contextlib.contextmanager
def concurrency_lock():
    """容量控制不能像统计账本一样旁路失败。锁只覆盖一次派发，不等待任务结束。"""
    if fcntl is None:
        raise DispatchError("并发限制需要 fcntl 文件锁，当前平台不支持。")
    handle = None
    try:
        CONCURRENCY_PATH.parent.mkdir(parents=True, exist_ok=True)
        handle = open(CONCURRENCY_PATH.with_suffix(".lock"), "a")
        deadline = time.monotonic() + CONCURRENCY_LOCK_WAIT_SECONDS
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise DispatchError("并发派发锁繁忙，请稍后重试；本次未创建线程。")
                time.sleep(0.05)
        yield
    except OSError as exc:
        raise DispatchError(f"并发状态访问失败：{exc}") from exc
    finally:
        if handle is not None:
            handle.close()


class ConcurrencySlots:
    def __init__(self, call, read_only=False):
        self.call, self.read_only = call, read_only
        self.threads = None
        try:
            data = json.loads(CONCURRENCY_PATH.read_text()) if CONCURRENCY_PATH.exists() else {"version": 1, "reservations": []}
            self.reservations = data["reservations"]
            if data.get("version") != 1 or not isinstance(self.reservations, list):
                raise ValueError("并发状态格式无效")
            for item in self.reservations:
                if (not isinstance(item, dict) or not isinstance(item.get("id"), str)
                        or not isinstance(item.get("provider"), str) or not isinstance(item.get("ts"), int)
                        or (item.get("thread") is not None and not isinstance(item["thread"], str))
                        or (item.get("model") is not None and not isinstance(item["model"], str))):
                    raise ValueError("并发占位字段无效")
        except (OSError, ValueError, KeyError, TypeError) as exc:
            raise DispatchError(f"无法读取并发状态 {CONCURRENCY_PATH}：{exc}") from exc

    def save(self):
        if self.read_only:
            return
        try:
            tmp = CONCURRENCY_PATH.with_suffix(".tmp")
            tmp.write_text(json.dumps({"version": 1, "reservations": self.reservations}, ensure_ascii=False, indent=2))
            tmp.replace(CONCURRENCY_PATH)
        except OSError as exc:
            raise DispatchError(f"无法保存并发状态：{exc}") from exc

    @staticmethod
    def occupied(thread):
        # 归档阻止队列继续派发；残留消息和交互不再预留容量。
        if thread.get("archivedAt") is not None:
            return False
        if thread.get("hasPendingInteraction") is not False:
            return True
        # error 的普通排队消息等待 retry，不代表正在执行；未知队列状态仍保守计数。
        # 原会话/自动重试不经过新建入口，启动后由实时状态重新计数。
        if thread.get("status") == "error":
            return thread.get("queuedWork") not in ("none", "waiting", "failed")
        return not (thread.get("status") == "idle" and thread.get("queuedWork") == "none")

    def refresh(self):
        if self.threads is not None:
            return
        rows = self.call("thread", "list", "--include-hidden")
        if not isinstance(rows, list) or any(not isinstance(t, dict) or not t.get("id") for t in rows):
            raise DispatchError("无法确定并发量：bb thread list 返回格式未知。")
        self.threads = {t["id"]: t for t in rows}
        keep = []
        for item in self.reservations:
            thread = self.threads.get(item.get("thread"))
            # 未知创建结果、线程暂未可见，均保持占位。idle 还需结束事件，避免初始 idle 提早释放。
            if thread is not None and not self.occupied(thread):
                # 归档本身足以终止派发资格，不要求存在 turn/completed 日志。
                if (thread.get("archivedAt") is not None
                        or turns_ended_since(self.call, thread["id"], item["ts"])):
                    continue
            keep.append(item)
        self.reservations = keep

    def usage(self, provider, models=None):
        self.refresh()
        known = {r["thread"]: r.get("model") for r in self.reservations
                 if r["provider"] == provider and r.get("thread")}

        def included(model):
            # BB 列表不带模型；新派发在占位中登记。旧占位/其他入口未知模型仍保守计数。
            return models is None or model is None or model in models

        active = {t["id"] for t in self.threads.values()
                  if t.get("providerId") == provider and self.occupied(t) and included(known.get(t["id"]))}
        held = [r for r in self.reservations if r["provider"] == provider and included(r.get("model"))]
        # 已可见的线程与占位只算一次；也计入其他入口创建的活跃线程，避免继续挤占 provider。
        return len(active | {r["thread"] for r in held if r.get("thread")}) + sum(not r.get("thread") for r in held)

    def reserve(self, provider, model):
        self.refresh()
        item = {"id": uuid.uuid4().hex, "provider": provider, "model": model,
                "ts": int(time.time()), "thread": None}
        self.reservations.append(item)
        self.save()  # 在 spawn 前落盘，崩溃或超时仍占位。
        return item


def provider_limits(agents):
    limits = {}
    for alias, agent in mapping(agents, "agents").items():
        agent = mapping(agent, f"agents.{alias}")
        if "max_concurrency" not in agent:
            continue
        limit = agent["max_concurrency"]
        if type(limit) is not int or limit < 1:
            raise DispatchError(f"agents.{alias}.max_concurrency 必须是正整数；不限制时省略。")
        provider = string(agent.get("provider"), f"agents.{alias}.provider")
        limits[provider] = min(limit, limits.get(provider, limit))
    return limits


def provider_model_scopes(agents):
    """同 provider 的受限模型合并成一个池；任一上限未限定模型则覆盖全部模型。"""
    scopes = {}
    for alias, agent in mapping(agents, "agents").items():
        agent = mapping(agent, f"agents.{alias}")
        if "concurrency_models" in agent and "max_concurrency" not in agent:
            raise DispatchError(f"agents.{alias}.concurrency_models 需要同时配置 max_concurrency。")
        if "max_concurrency" not in agent:
            continue
        models = agent.get("concurrency_models")
        if "concurrency_models" in agent:
            if (not isinstance(models, list) or not models
                    or any(not isinstance(v, str) or not v.strip() or v != v.strip() for v in models)):
                raise DispatchError(f"agents.{alias}.concurrency_models 必须是非空模型 ID 列表。")
            models = set(models)
        provider = string(agent.get("provider"), f"agents.{alias}.provider")
        if provider not in scopes:
            scopes[provider] = models
        elif scopes[provider] is None or models is None:
            scopes[provider] = None
        else:
            scopes[provider].update(models)
    return scopes


def concurrency_command(args, call=bb):
    def run():
        slots = ConcurrencySlots(call, read_only=not args.release_reservation)
        if args.release_reservation:
            matched = [r for r in slots.reservations if r["id"] == args.release_reservation]
            if not matched:
                raise DispatchError("未知并发占位 ID，未做修改。")
            if args.dry_run:
                return {"would_release": args.release_reservation, "dry_run": True}
            slots.reservations.remove(matched[0])
            slots.save()
            return {"released": args.release_reservation}
        slots.refresh()
        providers = sorted({t.get("providerId") for t in slots.threads.values() if t.get("providerId")}
                           | {r["provider"] for r in slots.reservations})
        return {"state_path": str(CONCURRENCY_PATH), "usage": {p: slots.usage(p) for p in providers},
                "reservations": slots.reservations}
    if args.release_reservation:
        with concurrency_lock():
            return run()
    return run()


def dispatch(args, call=bb, now=None):
    try:
        config = mapping(yaml.safe_load(Path(args.config).expanduser().read_text()), "config")
    except (OSError, yaml.YAMLError) as exc:
        raise DispatchError(f"无法读取配置 {args.config}：{exc}") from exc
    if config.get("version") != 2:
        raise DispatchError("配置必须包含 version: 2。")
    # 各环境的限制也决定是否进入锁；实际限额在解析目标环境后计算。
    configured = bool(provider_limits(config.get("agents", {})))
    provider_model_scopes(config.get("agents", {}))
    for override in mapping(config.get("environments", {}), "environments").values():
        configured = bool(provider_limits(mapping(override, "environment config").get("agents", {}))) or configured
        provider_model_scopes(mapping(override, "environment config").get("agents", {}))
    if not configured:
        return dispatch_unlocked(args, call, now, config, None)
    if args.dry_run:
        return dispatch_unlocked(args, call, now, config, ConcurrencySlots(call, read_only=True))
    with concurrency_lock():
        return dispatch_unlocked(args, call, now, config, ConcurrencySlots(call))


def dispatch_unlocked(args, call, now, config, slots):
    now = int(time.time() if now is None else now)
    # 从子线程首条消息复制回来的任务先去掉回报方式，续派的候选顺序与标题保持不变。
    args.task = string(args.task.split(REPORT_PROTOCOL_ANCHOR, 1)[0], "task")
    escalate_from = validate_contract_gates(args, call)
    unknown = (getattr(args, "unknown", None) or "").strip()

    environment_path = Path(args.environment).expanduser() if args.environment else None
    path_mode = environment_path is not None and environment_path.is_dir()
    context = call("status") if path_mode or not (args.project and args.environment) else {}
    current_project = (context.get("project") or {}).get("id")
    current_env = ((context.get("thread") or {}).get("environment") or {}).get("display", {}).get("id")
    if path_mode:
        environment = str(environment_path.resolve())
        project = args.project or current_project
        if not project:
            raise DispatchError("路径模式无法确定项目，请提供 --project <id>。")
        validation_environment = current_env
        if not validation_environment:
            raise DispatchError("路径模式需要代理环境校验 provider 和模型；请在 BB 线程里运行，或先准备可代理的当前环境。")
    else:
        environment = args.environment or current_env
        if not environment:
            raise DispatchError("无法确定环境，请提供 --environment <id-or-path>。")
        env = mapping(call("environment", "show", environment), "environment")
        project = args.project or env.get("projectId") or current_project
        if not project or env.get("projectId") != project or env.get("id") != environment:
            raise DispatchError("项目与环境不匹配；环境 ID 必须精确匹配现有环境。")
        validation_environment = environment
    # 环境块中的同名别名整体替换，避免混用另一台机器的模型和推理设置。
    override = {} if path_mode else mapping(
        mapping(config.get("environments", {}), "environments").get(environment, {}), "environment config"
    )
    defaults = {**mapping(config.get("defaults", {}), "defaults"), **mapping(override.get("defaults", {}), "environment defaults")}
    agents = {**mapping(config.get("agents", {}), "agents"), **mapping(override.get("agents", {}), "environment agents")}
    limits = provider_limits(agents)
    scopes = provider_model_scopes(agents)

    def limited(provider, model):
        return provider in limits and (scopes[provider] is None or model in scopes[provider])

    route = args.difficulty
    permission = args.permission_mode or override.get("permission_mode", config.get("permission_mode", "accept-edits"))
    if permission not in ("accept-edits", "auto", "full"):
        raise DispatchError("permission_mode 必须是 accept-edits、auto 或 full。")
    fast = configured_bool(override, config, "fast", True, "fast")
    chain, routing_mode, candidate_weights, full_chain = candidate_chain(args, defaults, route)

    def route_target(alias):
        """别名在本次路由下解析到的 (provider, model)；配置有误时返回 None，留给校验循环报错。"""
        try:
            agent = mapping(agents.get(alias), f"agents.{alias}")
            return string(agent.get("provider"), f"agents.{alias}.provider"), model_and_reasoning(agent, alias, route)[0]
        except DispatchError:
            return None

    lpath = ledger_path_from(args)
    ledger = load_ledger(lpath, strict=False)
    reconciled = reconcile_outcomes(ledger, call, now)
    explicit = []
    if args.fallback_from is not None and not args.dry_run:
        for skipped_alias in full_chain[:full_chain.index(args.fallback_from)]:
            target = route_target(skipped_alias)
            if target is not None:
                explicit.append((*target, "fallback-from"))
    for target_provider, target_model, reason in explicit:
        set_explicit_cooldown(ledger, target_provider, target_model, reason, now)
    health = health_cooldowns(ledger, now)

    def cooldown_for(alias):
        # 调用方点名从该别名续派时不按冷却跳过它。
        if args.fallback_from == alias:
            return None
        target = route_target(alias)
        return health.get(health_key(*target)) if target is not None else None

    providers = call("provider", "list", "--environment", validation_environment)
    # 同档 fallback：每个候选按本次路由项解析自己的 routes，首个通过校验者派发。
    # 优先跳过熔断冷却中的候选；若所有候选均在冷却中，则保底降级尝试，避免单候选链死锁。
    all_cooled = all(cooldown_for(alias) for alias in chain)
    attempts = []
    diverted = []
    catalogs = {}
    choice = None
    for index, alias in enumerate(chain):
        try:
            cd = None if all_cooled else cooldown_for(alias)
            if cd:
                diverted.append(alias)
                rem = int(cd["until"]) - now
                raise DispatchError(f"候选 {alias} 处于熔断冷却中（原因：{cd.get('reason')}，剩余 {rem}s）。")
            agent = mapping(agents.get(alias), f"agents.{alias}")
            provider = string(agent.get("provider"), f"agents.{alias}.provider")
            model, reasoning = model_and_reasoning(agent, alias, route)
            reasoning = args.reasoning if args.reasoning is not None else reasoning
            if reasoning is not None:
                reasoning = string(reasoning, "reasoning")
            if limited(provider, model):
                used = slots.usage(provider, scopes[provider])
                if used >= limits[provider]:
                    raise DispatchError(f"候选 {alias} 并发已满（{provider}: {used}/{limits[provider]}），本次跳过。", code="capacity_full")
            selected = unique(providers, "id", provider, "provider")
            if selected.get("available") is not True:
                raise DispatchError(f"provider {provider} 在校验环境不可用。")
            if permission not in selected.get("capabilities", {}).get("permissionModes", []):
                raise DispatchError(f"{provider} 不支持权限 {permission}；请选用兼容工具，或在任务已授权后显式指定权限。")
            catalog_key = (provider, model)
            if catalog_key not in catalogs:
                catalogs[catalog_key] = call(
                    "provider", "models", provider,
                    "--environment", validation_environment,
                    "--selected-model", model,
                )
            selected_model = unique(catalogs[catalog_key], "id", model, "模型")
            levels = [entry.get("reasoningEffort") for entry in (selected_model.get("supportedReasoningEfforts") or [])]
            if reasoning is not None and reasoning not in levels:
                raise DispatchError(f"模型 {model} 不支持 reasoning={reasoning}；可用值：{levels}。")
            agent_fast = agent.get("fast")
            if agent_fast is not None:
                if not isinstance(agent_fast, bool):
                    raise DispatchError(f"agents.{alias}.fast 必须是 true 或 false。")
                candidate_fast = agent_fast
            else:
                candidate_fast = fast
            if candidate_fast and supports_service_tier(selected, selected_model, "fast"):
                service_tier = "fast"
            elif supports_service_tier(selected, selected_model, "default"):
                service_tier = "default"
            else:
                service_tier = None
        except DispatchError as exc:
            attempts.append({"agent": alias, "error": str(exc)})
            continue
        choice = (index, alias, provider, model, reasoning, service_tier)
        break
    if choice is None:
        detail = "；".join(f"{item['agent']}: {item['error']}" for item in attempts)
        raise DispatchError(f"defaults.{route} 候选链 {chain} 均不可用：{detail}")
    index, alias, provider, model, reasoning, service_tier = choice
    fallbacks = chain[index + 1:]
    agent_cfg = agents.get(alias) if isinstance(agents.get(alias), dict) else {}
    shape = agent_cfg.get("shape") or AGENT_SHAPES.get(alias) or AGENT_SHAPES.get(provider) or "circle"
    title = thread_title(args.title, args.task, args.difficulty, shape=shape)
    # 父子关系不要求同项目：BB 的 --parent-thread 允许父线程在另一个项目，完成通知照常回到父线程。
    parent = context.get("thread") or {}
    if not parent and os.environ.get("BB_THREAD_ID"):
        parent = (call("thread", "show", os.environ["BB_THREAD_ID"]).get("thread") or {})
    # 只要关联了父线程就附加回报方式，跨项目也一样。
    task = args.task + REPORT_PROTOCOL_ANCHOR + REPORT_PROTOCOL if parent.get("id") else args.task
    command = ["thread", "spawn", "--project", project, "--environment", environment,
               "--provider", provider, "--model", model,
               "--permission-mode", permission, "--prompt", task]
    if reasoning is not None:
        command += ["--reasoning-level", reasoning]
    if service_tier is not None:
        command += ["--service-tier", service_tier]
    command += ["--title", title]
    if parent.get("id"):
        command += ["--parent-thread", parent["id"]]
    plan = dict(project=project, environment=environment, validation_environment=validation_environment,
                agent=alias, provider=provider,
                model=model, reasoning=reasoning, permission_mode=permission,
                service_tier=service_tier,
                difficulty=args.difficulty, title=title,
                routing_mode=routing_mode, candidate_weights=candidate_weights,
                candidates=chain, fallbacks=fallbacks, attempts=attempts)
    if escalate_from:
        plan["escalated_from"] = escalate_from
    if unknown:
        plan["unknown"] = unknown
    if reconciled:
        plan["reconciled"] = reconciled
    if limited(provider, model):
        plan["concurrency"] = {"provider": provider, "limit": limits[provider],
                               "used": slots.usage(provider, scopes[provider])}
        if scopes[provider] is not None:
            plan["concurrency"]["models"] = sorted(scopes[provider])
    if args.dry_run:
        return {"dry_run": True, "selection": plan, "argv": ["bb", *command, "--json"]}

    def persist(extra_cooldowns=(), entry=None):
        """把本次识别的终态、冷却和新条目合并进最新账本并记复盘事件；写入失败只告警。"""
        def apply(fresh):
            events = []
            entries = {item.get("id"): item for item in fresh.get("entries", []) if isinstance(item, dict)}
            for update in reconciled:
                target = entries.get(update["id"])
                # 并发期间别处已回写的终态优先。
                if target is not None and awaiting_outcome(target):
                    target.update(outcome=update["outcome"], outcome_ts=update["outcome_ts"])
                    # 这次故障已恢复，重试次数清零，下次报错从头计。
                    retries = int(target.pop("retries", 0) or 0)
                    target.pop("retry_ts", None)
                    if retries:
                        events.append(recovered_event(target, retries, now))
            for target_provider, target_model, reason in (*explicit, *extra_cooldowns):
                set_explicit_cooldown(fresh, target_provider, target_model, reason, now)
                events.append({"ts": now, "event": "cooled", "provider": target_provider,
                               "model": target_model, "reason": reason})
            table = fresh.setdefault("cooldowns", {})
            for key in [k for k, cd in table.items() if not isinstance(cd, dict) or int(cd.get("until") or 0) <= now]:
                del table[key]
            if entry is not None:
                append_ledger_entry(fresh, entry, now=now)
                events.append({"ts": now, "event": "dispatch", "thread": entry["id"], "difficulty": entry["difficulty"],
                               "agent": entry["agent"], "provider": entry["provider"], "model": entry["model"],
                               **({"diverted": diverted} if diverted else {})})
            return events
        try:
            return update_ledger(lpath, apply, strict=False)
        except Exception as exc:
            print(f"warning: 账本写入失败（已旁路忽略）：{exc}", file=sys.stderr)
            return None

    # 有模型范围时也登记范围外派发，以便之后查询不会把 simple 当成未知模型计入。
    reservation = slots.reserve(provider, model) if provider in limits else None
    try:
        result = call(*command)
    except DispatchError as exc:
        persist(extra_cooldowns=[(provider, model, "spawn-failed")])
        if reservation is not None:
            raise DispatchError(f"{exc} 并发占位 {reservation['id']} 已保留；先查询线程确认创建结果，"
                                "再用 --release-reservation <占位ID> 释放；勿直接重试创建。") from exc
        if fallbacks:
            raise DispatchError(
                f"{exc} 该候选已冷却；确认线程未创建后重跑同一命令会改用 {fallbacks[0]}"
                f"（也可用 --fallback-from {fallbacks[0]}）。"
            ) from exc
        raise
    thread_obj = result.get("thread") if isinstance(result, dict) and isinstance(result.get("thread"), dict) else result
    created_id = (thread_obj or {}).get("id") if isinstance(thread_obj, dict) else None
    if reservation is not None:
        if not created_id:
            raise DispatchError(f"创建响应缺少线程 ID，并发占位 {reservation['id']} 已保留；请先查询线程。")
        reservation["thread"] = str(created_id)
        slots.save()
    entry = None
    if created_id:
        entry = {
            "id": str(created_id),
            "ts": now,
            "project": project,
            "parent_thread": parent.get("id"),
            "difficulty": args.difficulty,
            "agent": alias,
            "provider": provider,
            "model": model,
            "reasoning": reasoning,
            "task_chars": effective_task_chars(args.task),
            "outcome": "spawned",
            "decision": None,
        }
        if unknown:
            entry["unknown"] = unknown[:UNKNOWN_MAX_CHARS]
        if escalate_from:
            entry["escalated_from"] = escalate_from
    merged = persist(entry=entry)
    if entry is not None and merged is not None:
        summary = summarize_ledger(merged, now=now)
        # 其他父线程的分档偏斜只在 --history-summary 里看，不打扰本次派发。
        hooks = [h for h in summary["review_hooks"]
                 if h["hook"] != "complex_share_high" or h["parent_thread"] == parent.get("id")]
        if hooks:
            plan["warnings"] = [h["message"] for h in hooks]
    # 返回完整创建回执，包括排队状态；不把创建成功宣称为任务完成。
    return {"dry_run": False, "selection": plan, "result": result}


def parser():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="示例：\n  bb-dispatch --difficulty simple --task '补充 README' --dry-run\n  bb-dispatch --difficulty medium --task '定位登录失败'\n  bb-dispatch --history-summary\n  bb-dispatch --on-failure thr_xxx\n  bb-dispatch --record-decision thr_xxx --decision accepted\n输出：stdout JSON，stderr 错误；退出码 0 成功，2 失败。")
    p.add_argument("--config", default=os.environ.get("BB_DISPATCH_CONFIG", str(Path.home() / ".config/bb-dispatch/config.yaml")), help="用户 YAML 配置路径，也可设置 BB_DISPATCH_CONFIG")
    p.add_argument("--ledger", default=os.environ.get("BB_DISPATCH_LEDGER_PATH", str(Path.home() / ".cache/bb-dispatch/ledger.json")), help="运行账本与熔断缓存路径，也可设置 BB_DISPATCH_LEDGER_PATH")
    p.add_argument("--difficulty", choices=["simple", "medium", "complex"], help="任务难度")
    p.add_argument("--task", help="任务目标、范围和验收要求")
    p.add_argument("--closed-scope", action="store_true", help="声明任务边界已闭合（目标文件、改法、验证已定）；未传 --escalate-from 时强制要求 simple")
    p.add_argument("--escalate-from", metavar="线程ID", help="前序失败或返工的低档线程 ID，用作升档或豁免长任务门禁的凭证")
    p.add_argument("--unknown", metavar="最大未知", help="一句话写出任务的最大未知；首次派 complex（未传 --escalate-from）时必填，截断后记入账本供复盘")
    p.add_argument("--max-task-chars", type=int, default=DEFAULT_MAX_TASK_CHARS, help=f"medium/complex 任务指导的最大字符数（默认 {DEFAULT_MAX_TASK_CHARS}，0 为不限制）")
    p.add_argument("--fallback-from", metavar="别名", help="从 defaults.<路由> 链中该别名起续派；链上排在它前面的候选按 provider 与模型冷却 15 分钟")
    p.add_argument("--reasoning", help="覆盖推理级别，仍校验模型目录")
    p.add_argument("--project", help="项目 ID；ID 模式默认环境所属项目，路径模式默认当前项目")
    p.add_argument("--environment", help="现有环境 ID 或本机工作区目录；默认当前 BB 环境")
    p.add_argument("--permission-mode", choices=["accept-edits", "auto", "full"], help="已获授权的权限；默认用户配置或 accept-edits")
    p.add_argument("--title", help="可选标题正文；按难度和账号自动加颜色形状前缀（圆/方/心），省略时从任务文本截取")
    p.add_argument("--dry-run", action="store_true", help="只读校验并输出启动参数，不创建线程；配合 --on-failure 只给出动作，不安排重试、不写账本")
    p.add_argument("--concurrency-status", action="store_true", help="只读查看 provider 当前占用与未决并发占位，不依赖统计账本")
    p.add_argument("--release-reservation", metavar="占位ID", help="确认创建结果后移除指定占位；活跃线程仍按 BB 实时状态计数")
    p.add_argument("--on-failure", metavar="线程ID", help="子线程报错后调用：先在原会话按 1、2、4 分钟退避重试，用尽才记失败并冷却该 provider 与模型")
    p.add_argument("--history-summary", "--stats", dest="history_summary", action="store_true", help="只读输出运行账本的聚合统计、当前冷却、确定性复盘 hooks，以及复盘日志近 7 天的重试与冷却汇总")
    p.add_argument("--record-decision", metavar="线程ID", help="按稳定线程 ID 回写父线程裁决或改正运行终态（覆盖而非追加）")
    p.add_argument("--outcome", choices=list(OUTCOME_KEYS), help="配合 --record-decision 改正运行终态；completed 按线程状态自动记录，failed 由 --on-failure 在重试用尽后记录，放弃任务也可手动记；各 failed* 取值都计入连续失败")
    p.add_argument("--decision", choices=list(DECISION_KEYS), help="配合 --record-decision 回写父线程裁决")
    return p


def main():
    args = parser().parse_args()
    try:
        if args.concurrency_status or args.release_reservation:
            print(json.dumps(concurrency_command(args), ensure_ascii=False, indent=2))
            return 0
        if args.history_summary:
            lpath, now = ledger_path_from(args), int(time.time())
            ledger = load_ledger(lpath, strict=False)
            # 只在内存里补齐终态，保持统计只读。
            reconcile_outcomes(ledger, bb, now)
            summary = summarize_ledger(ledger, now)
            summary["retry_review"] = summarize_events(lpath, now)
            print(json.dumps(summary, ensure_ascii=False, indent=2))
            return 0
        if args.on_failure is not None:
            print(json.dumps(on_failure_command(args), ensure_ascii=False, indent=2))
            return 0
        if args.record_decision is not None:
            print(json.dumps(record_decision_command(args), ensure_ascii=False, indent=2))
            return 0
        if not args.difficulty or args.task is None:
            raise DispatchError("派发模式必须提供 --difficulty 与 --task。")
        string(args.task, "task")
        result = dispatch(args)
        print(json.dumps(result, ensure_ascii=False, indent=2))
        # 调用方常只取 stdout 里的线程 ID，复盘提醒另写 stderr，过滤输出时也看得到。
        for warning in (result.get("selection") or {}).get("warnings") or []:
            print(f"提醒：{warning}", file=sys.stderr)
    except DispatchError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
