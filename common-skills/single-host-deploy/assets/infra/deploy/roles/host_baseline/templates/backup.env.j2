BACKUP_DB_CONTAINER={{ backup_db_container }}
BACKUP_DB_NAME={{ database.name }}
BACKUP_DB_USER={{ database.user }}
BACKUP_DIR={{ deploy_root }}/backups
BACKUP_FILE_PREFIX={{ backup.file_prefix | default(project_name) }}
BACKUP_RETENTION_DAYS={{ backup.retention_days | default(14) }}
BACKUP_OFFSITE_ENABLED={{ 'true' if (backup.offsite | default({})).enabled | default(false) | bool else 'false' }}
BACKUP_OFFSITE_REMOTE={{ (backup.offsite | default({})).remote | default('') }}
BACKUP_RCLONE_CONFIG={{ (backup.offsite | default({})).rclone_config | default('') }}
